## t/test_fleet.stk — assertion tests for the stryke-fleet package.
##
## Headless-CI safe: every PTY test spawns local `cat` / `sh` — no
## network, no SSH, no target hosts. Recipes are pure data and are
## asserted structurally.

use Fleet

# ── version / modules ────────────────────────────────────────────────
assert_match qr/^\d+\.\d+\.\d+$/, Fleet::version(), "Fleet::version is semver"
assert_eq scalar(Fleet::modules()), 4, "Fleet::modules lists four sublibs"

# ── Playbook::validate ───────────────────────────────────────────────
assert_eq Fleet::Playbook::validate([+{ send => "x\n" }]), 1, "validate counts steps"
assert_eq Fleet::Playbook::validate([]),                   0, "validate empty ok"
assert_dies fn { Fleet::Playbook::validate("nope") },        "validate rejects non-arrayref"
assert_dies fn { Fleet::Playbook::validate([+{}]) },         "validate rejects actionless step"
assert_dies fn { Fleet::Playbook::validate([+{ branches => "x" }]) },
                                                              "validate rejects scalar branches"

# ── Session round trip against cat ───────────────────────────────────
val $s = Fleet::Session::open("cat")
Fleet::Session::send($s, "echo-me\n")
assert_eq Fleet::Session::expect($s, qr/echo-me/, 10), "echo-me", "session expect matches echo"
assert_ok Fleet::Session::alive($s),                              "session alive"
Fleet::Session::close($s)
val $log = Fleet::Session::transcript($s)
assert_eq scalar(@$log), 3,                  "transcript has send+match+close"
assert_eq $log->[0]{event}, "send",          "transcript event 0 is send"
assert_eq $log->[1]{event}, "match",         "transcript event 1 is match"
assert_eq $log->[2]{event}, "close",         "transcript event 2 is close"

# ── Session branch table ─────────────────────────────────────────────
val $sb = Fleet::Session::open("cat")
Fleet::Session::send($sb, "pick-two\n")
val $picked = Fleet::Session::branch($sb, [
    +{ re => qr/pick-one/, do => fn { "one" } },
    +{ re => qr/pick-two/, do => fn { "two" } },
], 10)
assert_eq $picked, "two", "branch table picks matching arm and runs action"
Fleet::Session::close($sb)

# ── Session transcript helpers ───────────────────────────────────────
val $sh = Fleet::Session::open("cat")
Fleet::Session::send_line($sh, "no-newline")
assert_eq $sh->{log}[0]{data}, "no-newline\n", "send_line appends newline"
Fleet::Session::send_line($sh, "has-newline\n")
assert_eq $sh->{log}[1]{data}, "has-newline\n", "send_line leaves existing newline"
Fleet::Session::expect($sh, qr/no-newline/, 10)
Fleet::Session::expect($sh, qr/has-newline/, 10)
assert_eq scalar(@{ Fleet::Session::events($sh, "send") }),  2, "events filters send entries"
assert_eq scalar(@{ Fleet::Session::events($sh, "match") }), 2, "events filters match entries"
assert_eq join(",", @{ Fleet::Session::matches($sh) }), "no-newline,has-newline", "matches lists matched texts in order"
assert_eq Fleet::Session::last_match($sh), "has-newline", "last_match returns most recent"
assert_ok !Fleet::Session::timed_out($sh), "timed_out false when all matched"
Fleet::Session::expect($sh, qr/never-appears/, 1)
assert_ok Fleet::Session::timed_out($sh), "timed_out true after a timeout"
assert_match qr/send\tno-newline\\n/, Fleet::Session::transcript_text($sh), "transcript_text escapes newlines per line"
assert_match qr/timeout\t/, Fleet::Session::transcript_text($sh), "transcript_text includes timeout events"
Fleet::Session::close($sh)
assert_eq Fleet::Session::last_match(Fleet::Session::open("true")), undef, "last_match undef on fresh session"

# ── Session send_secret: transmit but redact in the transcript ────────
val $ss = Fleet::Session::open("cat")
Fleet::Session::send_secret($ss, "hunter2")
# The secret is actually transmitted — `cat` echoes it back over the PTY.
assert_eq Fleet::Session::expect($ss, qr/hunter2/, 10), "hunter2", "send_secret transmits the real text"
# ...but the transcript records only a redacted placeholder, never the secret.
assert_eq $ss->{log}[0]{event}, "send",  "send_secret logs a send event"
assert_eq $ss->{log}[0]{data},  "***",   "send_secret redacts the data"
assert_eq $ss->{log}[0]{secret}, 1,      "send_secret flags the entry as secret"
# No `send` event in the transcript carries the secret (it only redacts the send
# side; a real password prompt does not echo, unlike `cat` here).
assert_eq scalar(grep { $_->{data} =~ /hunter2/ } @{ Fleet::Session::events($ss, "send") }), 0,
    "send_secret keeps the secret out of every send event"
Fleet::Session::close($ss)

# ── Session send_control: send a control character (pexpect sendcontrol) ──
val $sc = Fleet::Session::open("cat")
Fleet::Session::send_control($sc, "c")
assert_eq $sc->{log}[0]{event}, "send_control", "send_control logs a send_control event"
assert_eq $sc->{log}[0]{char},  "c",            "send_control records the char"
assert_eq $sc->{log}[0]{byte},  3,              "send_control: c → 0x03 (Ctrl-C)"
Fleet::Session::send_control($sc, "D")
assert_eq $sc->{log}[1]{byte},  4,              "send_control: case-insensitive, D → 0x04"
assert_eq $sc->{log}[1]{char},  "d",            "send_control lowercases the char"
Fleet::Session::send_control($sc, "[")
assert_eq $sc->{log}[2]{byte},  27,             "send_control: [ → ESC 0x1b"
assert_dies fn { Fleet::Session::send_control($sc, "1") }, "send_control: dies on an unknown control char"
Fleet::Session::close($sc)

# Liveness after a *non-terminating* control: Ctrl-C/Ctrl-D legitimately kill
# `cat` (SIGINT / EOF), so check liveness on a fresh session that only receives
# ESC, which `cat` takes as ordinary input and keeps running.
val $sa = Fleet::Session::open("cat")
Fleet::Session::send_control($sa, "[")
assert_eq Fleet::Session::alive($sa), 1,        "send_control: a non-terminating control leaves the session alive"
Fleet::Session::close($sa)

# ── Playbook run: ok path ────────────────────────────────────────────
val $r = Fleet::Playbook::run("cat", [
    +{ send => "alpha\n" },
    +{ expect => qr/alpha/, timeout => 10, name => "alpha echo" },
    +{ send => "beta\n" },
    +{ expect => qr/beta/,  timeout => 10, name => "beta echo" },
])
assert_ok $r->{ok},            "playbook ok"
assert_eq $r->{steps_run}, 4,  "playbook ran all four steps"
assert_eq $r->{cmd}, "cat",    "playbook records cmd"
assert_ok scalar(grep { $_->{event} eq "match" && $_->{data} eq "alpha" } @{ $r->{transcript} }),
          "transcript captured alpha match"

# ── Playbook run: timeout fails the run ──────────────────────────────
val $rt = Fleet::Playbook::run("cat", [
    +{ expect => qr/never-appears/, timeout => 1, name => "ghost" },
])
assert_ok !$rt->{ok},                      "timeout playbook not ok"
assert_eq $rt->{failed_step}, 0,           "failed_step is 0"
assert_match qr/timeout on ghost/, $rt->{error}, "error names the step"

# ── Playbook run: optional timeout continues ─────────────────────────
val $ro = Fleet::Playbook::run("cat", [
    +{ expect => qr/never-appears/, timeout => 1, optional => 1 },
    +{ send => "still-here\n" },
    +{ expect => qr/still-here/, timeout => 10 },
])
assert_ok $ro->{ok},           "optional timeout does not fail run"
assert_eq $ro->{steps_run}, 3, "all steps ran past optional timeout"

# ── Playbook run: branches + send_matched ────────────────────────────
val $rb = Fleet::Playbook::run("cat", [
    +{ send => "are-you-sure\n" },
    +{
        branches => [
            +{ re => qr/are-you-sure/, do => fn { "yes\n" } },
            +{ re => qr/other/ },
        ],
        send_matched => 1,
        timeout      => 10,
    },
    +{ expect => qr/yes/, timeout => 10 },
])
assert_ok $rb->{ok}, "branch playbook with send_matched ok"

# ── Recipes are pure data ────────────────────────────────────────────
val $ssh = Fleet::Recipes::ssh_login(+{ password => "pw" })
assert_eq ref($ssh), "ARRAY",                       "ssh_login returns arrayref"
assert_eq scalar(@$ssh), 3,                         "ssh_login with password is 3 steps"
assert_eq $ssh->[1]{send}, "pw\n",                  "ssh_login sends password + newline"
assert_eq scalar(@{ Fleet::Recipes::ssh_login() }), 2, "ssh_login without password is 2 steps"
assert_eq Fleet::Playbook::validate($ssh), 3,       "ssh_login validates as playbook"

val $sudo = Fleet::Recipes::sudo(+{ password => "pw" })
assert_eq scalar(@$sudo), 2,           "sudo is 2 steps"
assert_dies fn { Fleet::Recipes::sudo(+{}) }, "sudo dies without password"

val $doas = Fleet::Recipes::doas(+{ password => "pw" })
assert_eq scalar(@$doas), 2,           "doas is 2 steps"
assert_eq $doas->[0]{send}, "pw\n",    "doas sends the password first"
assert_eq Fleet::Playbook::validate($doas), 2, "doas validates"
assert_dies fn { Fleet::Recipes::doas(+{}) }, "doas dies without password"

assert_eq Fleet::Playbook::validate(Fleet::Recipes::psql(+{ password => "x" })),    2, "psql validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::mysql()),                       1, "mysql validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::redis_cli(+{ password => "x" })), 3, "redis_cli auth validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::yes_to_all(4)),                 4, "yes_to_all count honored"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::cisco_enable(+{ enable_password => "x" })), 4, "cisco_enable validates"
assert_dies fn { Fleet::Recipes::cisco_enable(+{}) }, "cisco_enable dies without enable_password"
val $su = Fleet::Recipes::su(+{ password => "pw" })
assert_eq scalar(@$su), 2,             "su is 2 steps"
assert_eq $su->[0]{send}, "pw\n",      "su sends password + newline"
assert_dies fn { Fleet::Recipes::su(+{}) }, "su dies without password"

val $tel = Fleet::Recipes::telnet_login(+{ user => "admin", password => "pw" })
assert_eq scalar(@$tel), 3,            "telnet_login is 3 steps"
assert_eq $tel->[0]{send}, "admin\n",  "telnet_login sends user at login prompt"
assert_eq Fleet::Playbook::validate($tel), 3, "telnet_login validates"
assert_dies fn { Fleet::Recipes::telnet_login(+{ user => "x" }) }, "telnet_login dies without password"
assert_dies fn { Fleet::Recipes::telnet_login(+{ password => "x" }) }, "telnet_login dies without user"

assert_eq scalar(@{ Fleet::Recipes::sftp(+{ password => "pw" }) }), 3, "sftp with password is 3 steps"
assert_eq scalar(@{ Fleet::Recipes::sftp() }),                      2, "sftp without password is 2 steps"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::sftp()),        2, "sftp validates"

val $pwc = Fleet::Recipes::passwd_change(+{ old_password => "o", new_password => "n" })
assert_eq scalar(@$pwc), 4,            "passwd_change with old is 4 steps"
assert_eq $pwc->[1]{send}, "n\n",      "passwd_change sends new password"
assert_eq scalar(@{ Fleet::Recipes::passwd_change(+{ new_password => "n" }) }), 3, "passwd_change as root is 3 steps"
assert_dies fn { Fleet::Recipes::passwd_change(+{ old_password => "o" }) }, "passwd_change dies without new_password"

val $dkr = Fleet::Recipes::docker_login(+{ user => "u", password => "p" })
assert_eq scalar(@$dkr), 3,            "docker_login is 3 steps"
assert_eq Fleet::Playbook::validate($dkr), 3, "docker_login validates"
assert_dies fn { Fleet::Recipes::docker_login(+{ user => "u" }) }, "docker_login dies without password"

val $scp = Fleet::Recipes::scp(+{ password => "pw" })
assert_eq scalar(@$scp), 2,            "scp is 2 steps (host key + password)"
assert_eq $scp->[1]{send}, "pw\n",     "scp sends password"
assert_dies fn { Fleet::Recipes::scp(+{}) }, "scp dies without password"

val $gpg = Fleet::Recipes::gpg_decrypt(+{ passphrase => "secret" })
assert_eq scalar(@$gpg), 1,            "gpg_decrypt is 1 step"
assert_eq $gpg->[0]{send}, "secret\n", "gpg_decrypt sends passphrase"
assert_dies fn { Fleet::Recipes::gpg_decrypt(+{}) }, "gpg_decrypt dies without passphrase"

val $ftp = Fleet::Recipes::ftp_login(+{ user => "anon", password => "pw" })
assert_eq scalar(@$ftp), 3,            "ftp_login is 3 steps"
assert_eq $ftp->[0]{send}, "anon\n",   "ftp_login sends name first"
assert_eq Fleet::Playbook::validate($ftp), 3, "ftp_login validates"
assert_dies fn { Fleet::Recipes::ftp_login(+{ user => "x" }) }, "ftp_login dies without password"

val $pem = Fleet::Recipes::openssl_pem(+{ passphrase => "pp" })
assert_eq scalar(@$pem), 2,            "openssl_pem is 2 steps (enter + verify)"
assert_eq $pem->[0]{send}, "pp\n",     "openssl_pem sends passphrase"
assert_eq $pem->[1]{send}, "pp\n",     "openssl_pem re-sends on verify"
assert_dies fn { Fleet::Recipes::openssl_pem(+{}) }, "openssl_pem dies without passphrase"

assert_eq scalar(@{ Fleet::Recipes::mongo(+{ password => "x" }) }), 2, "mongo with password is 2 steps"
assert_eq scalar(@{ Fleet::Recipes::mongo() }),                     1, "mongo without password is 1 step"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::mongo()),       1, "mongo validates"

val $npm = Fleet::Recipes::npm_login(+{ user => "u", password => "p", email => "e@x.io" })
assert_eq scalar(@$npm), 3,            "npm_login is 3 steps"
assert_eq $npm->[2]{send}, "e@x.io\n", "npm_login sends email last"
assert_eq Fleet::Playbook::validate($npm), 3, "npm_login validates"
assert_dies fn { Fleet::Recipes::npm_login(+{ user => "u", password => "p" }) }, "npm_login dies without email"

assert_eq scalar(Fleet::Recipes::names()), 44, "recipe roster pinned at 44"

# restic: repository password, with an optional second (verify) prompt for `init`.
val $rt = Fleet::Recipes::restic(+{ password => "repo-pw" })
assert_eq scalar(@$rt), 2,             "restic is 2 steps (password + optional verify)"
assert_eq $rt->[0]{send}, "repo-pw\n", "restic sends the repository password"
assert_ok $rt->[1]{optional},          "restic verify step is optional (only init asks twice)"
assert_ok "enter password for repository: " =~ $rt->[0]{expect}, "restic matches the repository prompt"
assert_ok "enter password for new repository: " =~ $rt->[0]{expect}, "restic also matches the init prompt"
assert_dies fn { Fleet::Recipes::restic(+{}) }, "restic dies without a password"

# borg: repository passphrase, with an optional second (verify) prompt for `init`.
val $bg = Fleet::Recipes::borg(+{ password => "borg-pw" })
assert_eq scalar(@$bg), 2,             "borg is 2 steps (passphrase + optional verify)"
assert_eq $bg->[0]{send}, "borg-pw\n", "borg sends the repository passphrase"
assert_ok $bg->[1]{optional},          "borg verify step is optional (only init asks twice)"
assert_ok "Enter passphrase for key /srv/repo: " =~ $bg->[0]{expect}, "borg matches the existing-repo unlock prompt"
assert_ok "Enter new passphrase: " =~ $bg->[0]{expect},               "borg also matches the init new-passphrase prompt"
assert_ok "Enter same passphrase again: " =~ $bg->[1]{expect},        "borg verify matches the init confirm prompt"
assert_dies fn { Fleet::Recipes::borg(+{}) }, "borg dies without a password"

# age: the modern gpg alternative — passphrase prompt (decrypt) + optional confirm (encrypt -p).
val $ag = Fleet::Recipes::age(+{ password => "age-pw" })
assert_eq scalar(@$ag), 2,             "age is 2 steps (passphrase + optional confirm)"
assert_eq $ag->[0]{send}, "age-pw\n",  "age sends the passphrase"
assert_ok $ag->[1]{optional},          "age confirm step is optional (only -p asks twice)"
assert_ok "Enter passphrase: " =~ $ag->[0]{expect},  "age matches the decrypt prompt"
assert_ok "Enter passphrase (leave empty to autogenerate a secure one): " =~ $ag->[0]{expect}, "age also matches the encrypt -p prompt"
assert_ok "Confirm passphrase: " =~ $ag->[1]{expect}, "age confirm matches the -p confirm prompt"
assert_dies fn { Fleet::Recipes::age(+{}) }, "age dies without a password"

# cryptsetup: LUKS luksFormat/luksOpen passphrase prompts.
val $cs = Fleet::Recipes::cryptsetup(+{ password => "luks-pw" })
assert_eq scalar(@$cs), 3,               "cryptsetup is 3 steps (confirm + passphrase + verify)"
assert_ok $cs->[0]{optional},            "cryptsetup confirm step is optional (only luksFormat asks)"
assert_eq $cs->[0]{send}, "YES\n",       "cryptsetup confirms with capital-letters YES"
assert_eq $cs->[1]{send}, "luks-pw\n",   "cryptsetup sends the passphrase"
assert_ok $cs->[2]{optional},            "cryptsetup verify step is optional (only luksFormat verifies)"
assert_ok "Are you sure? (Type 'yes' in capital letters): " =~ $cs->[0]{expect}, "cryptsetup matches the overwrite confirmation"
assert_ok "Enter LUKS passphrase: " =~ $cs->[1]{expect},        "cryptsetup matches the luksFormat passphrase prompt"
assert_ok "Enter passphrase for /dev/sdd: " =~ $cs->[1]{expect}, "cryptsetup matches the luksOpen passphrase prompt"
assert_ok "Verify passphrase: " =~ $cs->[2]{expect},            "cryptsetup matches the verify prompt"
assert_dies fn { Fleet::Recipes::cryptsetup(+{}) }, "cryptsetup dies without a password"

# ldapsearch: single password step answering OpenLDAP's "Enter LDAP Password:".
val $ldap = Fleet::Recipes::ldapsearch(+{ password => "secret" })
assert_eq scalar(@$ldap), 1,           "ldapsearch is 1 step"
assert_eq $ldap->[0]{send}, "secret\n", "ldapsearch sends the bind password"
assert_ok "Enter LDAP Password: " =~ $ldap->[0]{expect}, "ldapsearch matches the OpenLDAP prompt"
assert_eq Fleet::Playbook::validate($ldap), 1, "ldapsearch validates"
assert_dies fn { Fleet::Recipes::ldapsearch(+{}) }, "ldapsearch dies without a password"

# ssh_copy_id: host-key (optional) + password + key-added confirmation (optional).
val $cp = Fleet::Recipes::ssh_copy_id(+{ password => "pw" })
assert_eq scalar(@$cp), 3, "ssh_copy_id is 3 steps"
assert_eq $cp->[1]{send}, "pw\n", "ssh_copy_id sends the remote password"
assert_ok $cp->[0]{optional}, "ssh_copy_id host-key step is optional"
assert_dies fn { Fleet::Recipes::ssh_copy_id(+{}) }, "ssh_copy_id needs a password"

# clickhouse_client: single password step answering "Password for user (NAME):".
val $ch = Fleet::Recipes::clickhouse_client(+{ password => "pw" })
assert_eq scalar(@$ch), 1, "clickhouse_client is 1 step"
assert_eq $ch->[0]{send}, "pw\n", "clickhouse_client sends the password"
assert_ok "Password for user (default):" =~ $ch->[0]{expect}, "clickhouse_client matches the real prompt"
assert_dies fn { Fleet::Recipes::clickhouse_client(+{}) }, "clickhouse_client needs password"

# ── v0.5.0 recipes ───────────────────────────────────────────────────
val $awscfg = Fleet::Recipes::aws_configure(+{ access_key => "AKIA", secret_key => "sek" })
assert_eq scalar(@$awscfg), 4, "aws_configure is 4 steps"
assert_eq $awscfg->[2]{send}, "\n", "aws_configure region defaults to blank line"
assert_eq $awscfg->[3]{send}, "json\n", "aws_configure output defaults to json"
assert_dies fn { Fleet::Recipes::aws_configure(+{ access_key => "x" }) }, "aws_configure needs secret_key"

val $hp = Fleet::Recipes::htpasswd(+{ password => "pw" })
assert_eq scalar(@$hp), 2, "htpasswd is new + confirm"
assert_eq $hp->[0]{send}, $hp->[1]{send}, "htpasswd sends the same password twice"
assert_dies fn { Fleet::Recipes::htpasswd(+{}) }, "htpasswd needs password"

assert_eq scalar(@{ Fleet::Recipes::keytool(+{ password => "p" }) }),               1, "keytool default is 1 step"
assert_eq scalar(@{ Fleet::Recipes::keytool(+{ password => "p", confirm => 1 }) }), 2, "keytool confirm adds re-enter"

assert_eq scalar(@{ Fleet::Recipes::ansible_vault(+{ password => "p" }) }),            1, "ansible_vault existing is 1 step"
assert_eq scalar(@{ Fleet::Recipes::ansible_vault(+{ password => "p", new => 1 }) }), 2, "ansible_vault new is 2 steps"

val $sp = Fleet::Recipes::sqlplus(+{ user => "scott", password => "tiger" })
assert_eq scalar(@$sp), 2, "sqlplus is user + password"
assert_eq $sp->[0]{send}, "scott\n", "sqlplus sends username first"
assert_dies fn { Fleet::Recipes::sqlplus(+{ user => "x" }) }, "sqlplus needs password"

assert_eq scalar(@{ Fleet::Recipes::op_signin(+{ password => "p" }) }), 1, "op_signin is 1 step"
assert_eq scalar(@{ Fleet::Recipes::ssh_add(+{ passphrase => "p" }) }), 1, "ssh_add is 1 step"
assert_dies fn { Fleet::Recipes::ssh_add(+{}) }, "ssh_add needs passphrase"

assert_eq scalar(@{ Fleet::Recipes::unzip_encrypted(+{ password => "p" }) }), 1, "unzip_encrypted is 1 step"

assert_eq scalar(@{ Fleet::Recipes::cqlsh() }),                     1, "cqlsh without password is just the prompt"
assert_eq scalar(@{ Fleet::Recipes::cqlsh(+{ password => "p" }) }), 2, "cqlsh with password adds auth"

assert_eq scalar(@{ Fleet::Recipes::gcloud_auth(+{ code => "abc" }) }), 1, "gcloud_auth is 1 step"

val $hk = Fleet::Recipes::heroku_login(+{ email => "e@x.io", password => "p" })
assert_eq scalar(@$hk), 2, "heroku_login is email + password"
assert_eq $hk->[0]{send}, "e@x.io\n", "heroku_login sends email first"
assert_dies fn { Fleet::Recipes::heroku_login(+{ email => "e@x.io" }) }, "heroku_login needs password"

# bw_unlock: single master-password step answering Bitwarden's "Master password:".
val $bw = Fleet::Recipes::bw_unlock(+{ password => "pw" })
assert_eq scalar(@$bw), 1, "bw_unlock is 1 step"
assert_eq $bw->[0]{send}, "pw\n", "bw_unlock sends the master password"
assert_ok "? Master password:" =~ $bw->[0]{expect}, "bw_unlock matches the Bitwarden prompt"
assert_dies fn { Fleet::Recipes::bw_unlock(+{}) }, "bw_unlock needs password"

# Every new recipe builds a structurally valid playbook (validate counts steps).
assert_eq Fleet::Playbook::validate($awscfg), 4, "aws_configure validates as a playbook"
assert_eq Fleet::Playbook::validate($sp),     2, "sqlplus validates as a playbook"
assert_eq Fleet::Playbook::validate($hk),     2, "heroku_login validates as a playbook"
assert_eq Fleet::Playbook::validate($bw),     1, "bw_unlock validates as a playbook"

# ── Fanout over local sessions ───────────────────────────────────────
val $results = Fleet::Fanout::run(["cat", "cat", "cat"], [
    +{ send => "ping\n" },
    +{ expect => qr/ping/, timeout => 10 },
])
assert_eq scalar(@$results), 3,                "fanout returns one result per target"
assert_ok $results->[0]{ok} && $results->[1]{ok} && $results->[2]{ok},
                                               "all fanout targets ok"

val $mixed = Fleet::Fanout::run(["cat", "cat"], [
    +{ expect => qr/never/, timeout => 1 },
])
val $part = Fleet::Fanout::partition($mixed)
assert_eq scalar(@{ $part->{ok} }),     0, "partition: none ok"
assert_eq scalar(@{ $part->{failed} }), 2, "partition: both failed"

assert_dies fn { Fleet::Fanout::run("cat", [+{ send => "x" }]) }, "fanout rejects scalar cmds"

# ── Fanout::batch — bounded concurrency, one result per target in order ──
val $batched = Fleet::Fanout::batch(["cat", "cat", "cat", "cat", "cat"], [
    +{ send => "go\n" },
    +{ expect => qr/go/, timeout => 10 },
], 2)
assert_eq scalar(@$batched), 5,                "batch: one result per target across batches"
assert_ok $batched->[0]{ok} && $batched->[4]{ok}, "batch: first and last targets both ran"
assert_dies fn { Fleet::Fanout::batch(["cat"], [+{ send => "x\n" }], 0) }, "batch: rejects batch_size < 1"
assert_dies fn { Fleet::Fanout::batch("cat", [+{ send => "x\n" }], 2) },   "batch: rejects scalar cmds"

# ── Playbook step retries with retry_send nudge ──────────────────────
val $rr = Fleet::Playbook::run("cat", [
    +{ expect => qr/pong/, timeout => 1, retries => 2, retry_send => "pong\n", name => "nudged" },
])
assert_ok $rr->{ok}, "retry_send nudge converts timeout into match"
val $rr_fail = Fleet::Playbook::run("cat", [
    +{ expect => qr/never/, timeout => 1, retries => 1, name => "still ghost" },
])
assert_ok !$rr_fail->{ok},                          "retries without nudge still time out"
assert_match qr/timeout on still ghost/, $rr_fail->{error}, "retry failure names the step"
assert_dies fn { Fleet::Playbook::validate([+{ send => "x", retries => -1 }]) }, "validate rejects negative retries"
assert_dies fn { Fleet::Playbook::validate([+{ send => "x", delay => -1 }]) },   "validate rejects negative delay"

# ── Playbook per-step delay ──────────────────────────────────────────
val $t0 = now_ms()
val $rd = Fleet::Playbook::run("cat", [
    +{ delay => 0.4, send => "paced\n" },
    +{ expect => qr/paced/, timeout => 10 },
])
assert_ok $rd->{ok},                 "delayed playbook ok"
assert_ok now_ms() - $t0 >= 300,     "delay actually paced the run (ms clock)"

# ── Playbook::dry_run is pure ────────────────────────────────────────
val $plan = Fleet::Playbook::dry_run([
    +{ send => "hi\n", name => "greet" },
    +{ expect => qr/x/, retries => 2, optional => 1 },
])
assert_match qr/greet.*send 3b/,            $plan, "dry_run shows send byte count"
assert_match qr/retries 2, optional/,       $plan, "dry_run shows retries and optional"
assert_dies fn { Fleet::Playbook::dry_run("nope") }, "dry_run validates input"

# ── Fanout::summarize ────────────────────────────────────────────────
val $mix = Fleet::Fanout::run(["cat", "cat"], [ +{ expect => qr/never/, timeout => 1, name => "ghost" } ])
val $sum = Fleet::Fanout::summarize($mix)
assert_eq $sum->{total},  2, "summarize total"
assert_eq $sum->{ok},     0, "summarize ok count"
assert_eq $sum->{failed}, 2, "summarize failed count"
assert_match qr/^cat: timeout on ghost/, $sum->{errors}[0], "summarize error line format"

# ── Fanout::group_by_error ───────────────────────────────────────────
# Pure over a synthetic result set so the error strings are controlled.
val $res = [
    +{ cmd => "ssh a", ok => 0, error => "connection refused" },
    +{ cmd => "ssh b", ok => 0, error => "connection refused" },
    +{ cmd => "ssh c", ok => 0, error => "auth failed" },
    +{ cmd => "ssh d", ok => 1 },
]
val $grp = Fleet::Fanout::group_by_error($res)
assert_eq scalar(keys %$grp),                       2,       "group_by_error: 2 distinct errors (ok ignored)"
assert_eq scalar(@{ $grp->{"connection refused"} }), 2,      "group_by_error: two hosts share an error"
assert_eq scalar(@{ $grp->{"auth failed"} }),        1,      "group_by_error: lone error bucket"
assert_eq $grp->{"connection refused"}[0],          "ssh a", "group_by_error: bucket keeps the cmd, order preserved"
assert_eq scalar(keys %{ Fleet::Fanout::group_by_error([ +{ cmd => "x", ok => 1 } ]) }), 0, "group_by_error: all-ok → empty"

# ── Fanout::group_by_output — config-drift detection over successes ───
# Pure over a synthetic result set; buckets ok hosts by their last output.
val $dres = [
    +{ cmd => "ssh a", ok => 1, transcript => [ +{ event => "match", data => "5.15.0" } ] },
    +{ cmd => "ssh b", ok => 1, transcript => [ +{ event => "match", data => "5.15.0" } ] },
    +{ cmd => "ssh c", ok => 1, transcript => [ +{ event => "match", data => "6.1.0" } ] },
    +{ cmd => "ssh d", ok => 0, transcript => [ +{ event => "match", data => "5.15.0" } ] },
]
val $byout = Fleet::Fanout::group_by_output($dres)
assert_eq scalar(keys %$byout),            2,       "group_by_output: 2 distinct outputs (failed host ignored)"
assert_eq scalar(@{ $byout->{"5.15.0"} }), 2,       "group_by_output: majority kernel bucket"
assert_eq scalar(@{ $byout->{"6.1.0"} }),  1,       "group_by_output: the outlier host"
assert_eq $byout->{"5.15.0"}[0],           "ssh a", "group_by_output: bucket keeps cmd, order preserved"
# A custom key fn extracts a precise field instead of the last transcript line.
val $kres = [
    +{ cmd => "ssh a", ok => 1, version => "1.2.3" },
    +{ cmd => "ssh b", ok => 1, version => "1.2.4" },
]
val $byver = Fleet::Fanout::group_by_output($kres, fn ($r) { $r->{version} })
assert_eq scalar(keys %$byver), 2, "group_by_output: custom key fn buckets by an extracted field"
assert_eq scalar(keys %{ Fleet::Fanout::group_by_output([ +{ cmd => "x", ok => 0 } ]) }), 0, "group_by_output: all-failed → empty"

# ── Fanout::grep_transcript ──────────────────────────────────────────
# Pure over a synthetic result set with transcript event lists.
val $tres = [
    +{ cmd => "ssh a", ok => 1, transcript => [ +{ event => "match", data => "v1.2.3 ready" } ] },
    +{ cmd => "ssh b", ok => 1, transcript => [ +{ event => "match", data => "DEPRECATED: foo" } ] },
    +{ cmd => "ssh c", ok => 0, transcript => [ +{ event => "match", data => "v1.2.3 ready" }, +{ event => "timeout", data => "" } ] },
    +{ cmd => "ssh d", ok => 1, transcript => [ +{ event => "send", data => "go\n" } ] },
]
val $hits = Fleet::Fanout::grep_transcript($tres, qr/v1\.2\.3/)
assert_eq scalar(@$hits),     2,            "grep_transcript: two hosts printed the version"
assert_eq $hits->[0]{cmd},    "ssh a",      "grep_transcript: keeps cmd, order preserved"
assert_eq $hits->[0]{match},  "v1.2.3 ready", "grep_transcript: match is the matching event data"
assert_eq $hits->[1]{ok},     0,            "grep_transcript: includes a failed host that still matched"
# A plain string pattern is accepted too.
assert_eq scalar(@{ Fleet::Fanout::grep_transcript($tres, "DEPRECATED") }), 1, "grep_transcript: string pattern, lone deprecation warning"
assert_eq scalar(@{ Fleet::Fanout::grep_transcript($tres, qr/nope/) }), 0, "grep_transcript: no matches → empty"

# ── Fanout::retry_failed ─────────────────────────────────────────────
val $retried = Fleet::Fanout::retry_failed($mix, [ +{ send => "ok\n" } ])
assert_eq scalar(@$retried), 2,        "retry_failed preserves result count"
assert_ok $retried->[0]{ok},           "retry_failed re-runs failed entry"
assert_ok $retried->[0]{retried},      "retry_failed tags re-run entries"
val $all_ok = Fleet::Fanout::run(["cat"], [ +{ send => "fine\n" } ])
val $untouched = Fleet::Fanout::retry_failed($all_ok, [ +{ send => "x\n" } ])
assert_ok !$untouched->[0]{retried},   "retry_failed leaves ok entries untouched"

# ── Fanout::retry_until — persistent retry up to N attempts ──────────
# A send-only playbook always succeeds, so each failed entry recovers on attempt 1.
val $ru = Fleet::Fanout::retry_until($mix, [ +{ send => "ok\n" } ], 3)
assert_eq scalar(@$ru), 2,             "retry_until preserves result count"
assert_ok $ru->[0]{ok},                "retry_until recovers a failed entry"
assert_eq $ru->[0]{attempts}, 1,       "retry_until: succeeded on the first retry"
# Already-ok entries pass through untouched (no attempts/retried).
val $ru_ok = Fleet::Fanout::retry_until($all_ok, [ +{ send => "x\n" } ], 3)
assert_ok !$ru_ok->[0]{retried},       "retry_until leaves ok entries untouched"
assert_dies fn { Fleet::Fanout::retry_until($mix, [ +{ send => "x\n" } ], 0) }, "retry_until: rejects max_attempts < 1"

# ── Integration: recipes + playbook + transcript + fanout together ───
# Exercises the four layers in one flow on local processes only — the
# interactions the per-layer tests don't cover.

# 1. Splice a pure recipe into a larger playbook; it validates as one.
val @plan = ( @{ Fleet::Recipes::yes_to_all(2) }, +{ send => "go\n" } )
assert_eq Fleet::Playbook::validate(\@plan), 3, "integration: recipe splice validates as a playbook"

# 2. Session transcript inspection over a real cat round trip.
val $s = Fleet::Session::open("cat")
Fleet::Session::send_line($s, "alpha")
Fleet::Session::expect($s, qr/alpha/, 10)
Fleet::Session::send_line($s, "beta")
Fleet::Session::expect($s, qr/beta/, 10)
assert_eq join(",", @{ Fleet::Session::matches($s) }), "alpha,beta", "integration: matches recorded in order"
assert_eq Fleet::Session::last_match($s),               "beta",       "integration: last_match is most recent"
assert_ok !Fleet::Session::timed_out($s),                             "integration: no timeout on clean run"
assert_eq scalar(@{ Fleet::Session::events($s, "send") }), 2,         "integration: two send events"
Fleet::Session::close($s)
assert_match qr/close\tcat/, Fleet::Session::transcript_text($s),     "integration: transcript_text shows close"

# 3. Fanout summarize over an all-ok run and an all-fail run. (A mixed
# run is avoided: the PTY line discipline echoes input, so a dead target
# still "matches" an input-derived pattern — process death is not a
# reliable failure signal here.)
val $ok_res = Fleet::Fanout::run(["cat", "cat"], [
    +{ send => "ping\n" },
    +{ expect => qr/ping/, timeout => 5, name => "echo" },
])
val $ok_sum = Fleet::Fanout::summarize($ok_res)
assert_eq $ok_sum->{total},  2, "integration: all-ok fanout total"
assert_eq $ok_sum->{ok},     2, "integration: all-ok fanout both ok"
assert_eq $ok_sum->{failed}, 0, "integration: all-ok fanout none failed"

val $bad_res = Fleet::Fanout::run(["cat", "cat"], [
    +{ expect => qr/never-appears/, timeout => 1, name => "ghost" },
])
val $bad_sum = Fleet::Fanout::summarize($bad_res)
assert_eq $bad_sum->{failed}, 2, "integration: all-fail fanout both failed"
assert_match qr/ghost/, $bad_sum->{errors}[0], "integration: summarize names the failed step"
val $fixed = Fleet::Fanout::retry_failed($bad_res, [ +{ send => "ok\n" } ])
assert_ok $fixed->[0]{retried}, "integration: retry_failed re-ran the failures"

test_run
