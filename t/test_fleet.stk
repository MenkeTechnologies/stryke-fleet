## t/test_fleet.stk — assertion tests for the stryke-fleet package.
##
## Headless-CI safe: every PTY test spawns local `cat` / `sh` — no
## network, no SSH, no target hosts. Recipes are pure data and are
## asserted structurally.

use Fleet

# ── version / modules ────────────────────────────────────────────────
assert_match qr/^\d+\.\d+\.\d+$/, Fleet::version(), "Fleet::version is semver"
assert_eq scalar(Fleet::modules()), 4, "Fleet::modules lists four sublibs"

# ── Playbook::validate ───────────────────────────────────────────────
assert_eq Fleet::Playbook::validate([+{ send => "x\n" }]), 1, "validate counts steps"
assert_eq Fleet::Playbook::validate([]),                   0, "validate empty ok"
assert_dies fn { Fleet::Playbook::validate("nope") },        "validate rejects non-arrayref"
assert_dies fn { Fleet::Playbook::validate([+{}]) },         "validate rejects actionless step"
assert_dies fn { Fleet::Playbook::validate([+{ branches => "x" }]) },
                                                              "validate rejects scalar branches"

# ── Session round trip against cat ───────────────────────────────────
val $s = Fleet::Session::open("cat")
Fleet::Session::send($s, "echo-me\n")
assert_eq Fleet::Session::expect($s, qr/echo-me/, 10), "echo-me", "session expect matches echo"
assert_ok Fleet::Session::alive($s),                              "session alive"
Fleet::Session::close($s)
val $log = Fleet::Session::transcript($s)
assert_eq scalar(@$log), 3,                  "transcript has send+match+close"
assert_eq $log->[0]{event}, "send",          "transcript event 0 is send"
assert_eq $log->[1]{event}, "match",         "transcript event 1 is match"
assert_eq $log->[2]{event}, "close",         "transcript event 2 is close"

# ── Session branch table ─────────────────────────────────────────────
val $sb = Fleet::Session::open("cat")
Fleet::Session::send($sb, "pick-two\n")
val $picked = Fleet::Session::branch($sb, [
    +{ re => qr/pick-one/, do => fn { "one" } },
    +{ re => qr/pick-two/, do => fn { "two" } },
], 10)
assert_eq $picked, "two", "branch table picks matching arm and runs action"
Fleet::Session::close($sb)

# ── Session transcript helpers ───────────────────────────────────────
val $sh = Fleet::Session::open("cat")
Fleet::Session::send_line($sh, "no-newline")
assert_eq $sh->{log}[0]{data}, "no-newline\n", "send_line appends newline"
Fleet::Session::send_line($sh, "has-newline\n")
assert_eq $sh->{log}[1]{data}, "has-newline\n", "send_line leaves existing newline"
Fleet::Session::expect($sh, qr/no-newline/, 10)
Fleet::Session::expect($sh, qr/has-newline/, 10)
assert_eq scalar(@{ Fleet::Session::events($sh, "send") }),  2, "events filters send entries"
assert_eq scalar(@{ Fleet::Session::events($sh, "match") }), 2, "events filters match entries"
assert_eq join(",", @{ Fleet::Session::matches($sh) }), "no-newline,has-newline", "matches lists matched texts in order"
assert_eq Fleet::Session::last_match($sh), "has-newline", "last_match returns most recent"
assert_ok !Fleet::Session::timed_out($sh), "timed_out false when all matched"
Fleet::Session::expect($sh, qr/never-appears/, 1)
assert_ok Fleet::Session::timed_out($sh), "timed_out true after a timeout"
assert_match qr/send\tno-newline\\n/, Fleet::Session::transcript_text($sh), "transcript_text escapes newlines per line"
assert_match qr/timeout\t/, Fleet::Session::transcript_text($sh), "transcript_text includes timeout events"
Fleet::Session::close($sh)
assert_eq Fleet::Session::last_match(Fleet::Session::open("true")), undef, "last_match undef on fresh session"

# ── Playbook run: ok path ────────────────────────────────────────────
val $r = Fleet::Playbook::run("cat", [
    +{ send => "alpha\n" },
    +{ expect => qr/alpha/, timeout => 10, name => "alpha echo" },
    +{ send => "beta\n" },
    +{ expect => qr/beta/,  timeout => 10, name => "beta echo" },
])
assert_ok $r->{ok},            "playbook ok"
assert_eq $r->{steps_run}, 4,  "playbook ran all four steps"
assert_eq $r->{cmd}, "cat",    "playbook records cmd"
assert_ok scalar(grep { $_->{event} eq "match" && $_->{data} eq "alpha" } @{ $r->{transcript} }),
          "transcript captured alpha match"

# ── Playbook run: timeout fails the run ──────────────────────────────
val $rt = Fleet::Playbook::run("cat", [
    +{ expect => qr/never-appears/, timeout => 1, name => "ghost" },
])
assert_ok !$rt->{ok},                      "timeout playbook not ok"
assert_eq $rt->{failed_step}, 0,           "failed_step is 0"
assert_match qr/timeout on ghost/, $rt->{error}, "error names the step"

# ── Playbook run: optional timeout continues ─────────────────────────
val $ro = Fleet::Playbook::run("cat", [
    +{ expect => qr/never-appears/, timeout => 1, optional => 1 },
    +{ send => "still-here\n" },
    +{ expect => qr/still-here/, timeout => 10 },
])
assert_ok $ro->{ok},           "optional timeout does not fail run"
assert_eq $ro->{steps_run}, 3, "all steps ran past optional timeout"

# ── Playbook run: branches + send_matched ────────────────────────────
val $rb = Fleet::Playbook::run("cat", [
    +{ send => "are-you-sure\n" },
    +{
        branches => [
            +{ re => qr/are-you-sure/, do => fn { "yes\n" } },
            +{ re => qr/other/ },
        ],
        send_matched => 1,
        timeout      => 10,
    },
    +{ expect => qr/yes/, timeout => 10 },
])
assert_ok $rb->{ok}, "branch playbook with send_matched ok"

# ── Recipes are pure data ────────────────────────────────────────────
val $ssh = Fleet::Recipes::ssh_login(+{ password => "pw" })
assert_eq ref($ssh), "ARRAY",                       "ssh_login returns arrayref"
assert_eq scalar(@$ssh), 3,                         "ssh_login with password is 3 steps"
assert_eq $ssh->[1]{send}, "pw\n",                  "ssh_login sends password + newline"
assert_eq scalar(@{ Fleet::Recipes::ssh_login() }), 2, "ssh_login without password is 2 steps"
assert_eq Fleet::Playbook::validate($ssh), 3,       "ssh_login validates as playbook"

val $sudo = Fleet::Recipes::sudo(+{ password => "pw" })
assert_eq scalar(@$sudo), 2,           "sudo is 2 steps"
assert_dies fn { Fleet::Recipes::sudo(+{}) }, "sudo dies without password"

assert_eq Fleet::Playbook::validate(Fleet::Recipes::psql(+{ password => "x" })),    2, "psql validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::mysql()),                       1, "mysql validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::redis_cli(+{ password => "x" })), 3, "redis_cli auth validates"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::yes_to_all(4)),                 4, "yes_to_all count honored"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::cisco_enable(+{ enable_password => "x" })), 4, "cisco_enable validates"
assert_dies fn { Fleet::Recipes::cisco_enable(+{}) }, "cisco_enable dies without enable_password"
val $su = Fleet::Recipes::su(+{ password => "pw" })
assert_eq scalar(@$su), 2,             "su is 2 steps"
assert_eq $su->[0]{send}, "pw\n",      "su sends password + newline"
assert_dies fn { Fleet::Recipes::su(+{}) }, "su dies without password"

val $tel = Fleet::Recipes::telnet_login(+{ user => "admin", password => "pw" })
assert_eq scalar(@$tel), 3,            "telnet_login is 3 steps"
assert_eq $tel->[0]{send}, "admin\n",  "telnet_login sends user at login prompt"
assert_eq Fleet::Playbook::validate($tel), 3, "telnet_login validates"
assert_dies fn { Fleet::Recipes::telnet_login(+{ user => "x" }) }, "telnet_login dies without password"
assert_dies fn { Fleet::Recipes::telnet_login(+{ password => "x" }) }, "telnet_login dies without user"

assert_eq scalar(@{ Fleet::Recipes::sftp(+{ password => "pw" }) }), 3, "sftp with password is 3 steps"
assert_eq scalar(@{ Fleet::Recipes::sftp() }),                      2, "sftp without password is 2 steps"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::sftp()),        2, "sftp validates"

val $pwc = Fleet::Recipes::passwd_change(+{ old_password => "o", new_password => "n" })
assert_eq scalar(@$pwc), 4,            "passwd_change with old is 4 steps"
assert_eq $pwc->[1]{send}, "n\n",      "passwd_change sends new password"
assert_eq scalar(@{ Fleet::Recipes::passwd_change(+{ new_password => "n" }) }), 3, "passwd_change as root is 3 steps"
assert_dies fn { Fleet::Recipes::passwd_change(+{ old_password => "o" }) }, "passwd_change dies without new_password"

val $dkr = Fleet::Recipes::docker_login(+{ user => "u", password => "p" })
assert_eq scalar(@$dkr), 3,            "docker_login is 3 steps"
assert_eq Fleet::Playbook::validate($dkr), 3, "docker_login validates"
assert_dies fn { Fleet::Recipes::docker_login(+{ user => "u" }) }, "docker_login dies without password"

val $scp = Fleet::Recipes::scp(+{ password => "pw" })
assert_eq scalar(@$scp), 2,            "scp is 2 steps (host key + password)"
assert_eq $scp->[1]{send}, "pw\n",     "scp sends password"
assert_dies fn { Fleet::Recipes::scp(+{}) }, "scp dies without password"

val $gpg = Fleet::Recipes::gpg_decrypt(+{ passphrase => "secret" })
assert_eq scalar(@$gpg), 1,            "gpg_decrypt is 1 step"
assert_eq $gpg->[0]{send}, "secret\n", "gpg_decrypt sends passphrase"
assert_dies fn { Fleet::Recipes::gpg_decrypt(+{}) }, "gpg_decrypt dies without passphrase"

val $ftp = Fleet::Recipes::ftp_login(+{ user => "anon", password => "pw" })
assert_eq scalar(@$ftp), 3,            "ftp_login is 3 steps"
assert_eq $ftp->[0]{send}, "anon\n",   "ftp_login sends name first"
assert_eq Fleet::Playbook::validate($ftp), 3, "ftp_login validates"
assert_dies fn { Fleet::Recipes::ftp_login(+{ user => "x" }) }, "ftp_login dies without password"

val $pem = Fleet::Recipes::openssl_pem(+{ passphrase => "pp" })
assert_eq scalar(@$pem), 2,            "openssl_pem is 2 steps (enter + verify)"
assert_eq $pem->[0]{send}, "pp\n",     "openssl_pem sends passphrase"
assert_eq $pem->[1]{send}, "pp\n",     "openssl_pem re-sends on verify"
assert_dies fn { Fleet::Recipes::openssl_pem(+{}) }, "openssl_pem dies without passphrase"

assert_eq scalar(@{ Fleet::Recipes::mongo(+{ password => "x" }) }), 2, "mongo with password is 2 steps"
assert_eq scalar(@{ Fleet::Recipes::mongo() }),                     1, "mongo without password is 1 step"
assert_eq Fleet::Playbook::validate(Fleet::Recipes::mongo()),       1, "mongo validates"

val $npm = Fleet::Recipes::npm_login(+{ user => "u", password => "p", email => "e@x.io" })
assert_eq scalar(@$npm), 3,            "npm_login is 3 steps"
assert_eq $npm->[2]{send}, "e@x.io\n", "npm_login sends email last"
assert_eq Fleet::Playbook::validate($npm), 3, "npm_login validates"
assert_dies fn { Fleet::Recipes::npm_login(+{ user => "u", password => "p" }) }, "npm_login dies without email"

assert_eq scalar(Fleet::Recipes::names()), 18, "recipe roster pinned at 18"

# ── Fanout over local sessions ───────────────────────────────────────
val $results = Fleet::Fanout::run(["cat", "cat", "cat"], [
    +{ send => "ping\n" },
    +{ expect => qr/ping/, timeout => 10 },
])
assert_eq scalar(@$results), 3,                "fanout returns one result per target"
assert_ok $results->[0]{ok} && $results->[1]{ok} && $results->[2]{ok},
                                               "all fanout targets ok"

val $mixed = Fleet::Fanout::run(["cat", "cat"], [
    +{ expect => qr/never/, timeout => 1 },
])
val $part = Fleet::Fanout::partition($mixed)
assert_eq scalar(@{ $part->{ok} }),     0, "partition: none ok"
assert_eq scalar(@{ $part->{failed} }), 2, "partition: both failed"

assert_dies fn { Fleet::Fanout::run("cat", [+{ send => "x" }]) }, "fanout rejects scalar cmds"

# ── Playbook step retries with retry_send nudge ──────────────────────
val $rr = Fleet::Playbook::run("cat", [
    +{ expect => qr/pong/, timeout => 1, retries => 2, retry_send => "pong\n", name => "nudged" },
])
assert_ok $rr->{ok}, "retry_send nudge converts timeout into match"
val $rr_fail = Fleet::Playbook::run("cat", [
    +{ expect => qr/never/, timeout => 1, retries => 1, name => "still ghost" },
])
assert_ok !$rr_fail->{ok},                          "retries without nudge still time out"
assert_match qr/timeout on still ghost/, $rr_fail->{error}, "retry failure names the step"
assert_dies fn { Fleet::Playbook::validate([+{ send => "x", retries => -1 }]) }, "validate rejects negative retries"
assert_dies fn { Fleet::Playbook::validate([+{ send => "x", delay => -1 }]) },   "validate rejects negative delay"

# ── Playbook per-step delay ──────────────────────────────────────────
val $t0 = now_ms()
val $rd = Fleet::Playbook::run("cat", [
    +{ delay => 0.4, send => "paced\n" },
    +{ expect => qr/paced/, timeout => 10 },
])
assert_ok $rd->{ok},                 "delayed playbook ok"
assert_ok now_ms() - $t0 >= 300,     "delay actually paced the run (ms clock)"

# ── Playbook::dry_run is pure ────────────────────────────────────────
val $plan = Fleet::Playbook::dry_run([
    +{ send => "hi\n", name => "greet" },
    +{ expect => qr/x/, retries => 2, optional => 1 },
])
assert_match qr/greet.*send 3b/,            $plan, "dry_run shows send byte count"
assert_match qr/retries 2, optional/,       $plan, "dry_run shows retries and optional"
assert_dies fn { Fleet::Playbook::dry_run("nope") }, "dry_run validates input"

# ── Fanout::summarize ────────────────────────────────────────────────
val $mix = Fleet::Fanout::run(["cat", "cat"], [ +{ expect => qr/never/, timeout => 1, name => "ghost" } ])
val $sum = Fleet::Fanout::summarize($mix)
assert_eq $sum->{total},  2, "summarize total"
assert_eq $sum->{ok},     0, "summarize ok count"
assert_eq $sum->{failed}, 2, "summarize failed count"
assert_match qr/^cat: timeout on ghost/, $sum->{errors}[0], "summarize error line format"

# ── Fanout::retry_failed ─────────────────────────────────────────────
val $retried = Fleet::Fanout::retry_failed($mix, [ +{ send => "ok\n" } ])
assert_eq scalar(@$retried), 2,        "retry_failed preserves result count"
assert_ok $retried->[0]{ok},           "retry_failed re-runs failed entry"
assert_ok $retried->[0]{retried},      "retry_failed tags re-run entries"
val $all_ok = Fleet::Fanout::run(["cat"], [ +{ send => "fine\n" } ])
val $untouched = Fleet::Fanout::retry_failed($all_ok, [ +{ send => "x\n" } ])
assert_ok !$untouched->[0]{retried},   "retry_failed leaves ok entries untouched"

# ── Integration: recipes + playbook + transcript + fanout together ───
# Exercises the four layers in one flow on local processes only — the
# interactions the per-layer tests don't cover.

# 1. Splice a pure recipe into a larger playbook; it validates as one.
val @plan = ( @{ Fleet::Recipes::yes_to_all(2) }, +{ send => "go\n" } )
assert_eq Fleet::Playbook::validate(\@plan), 3, "integration: recipe splice validates as a playbook"

# 2. Session transcript inspection over a real cat round trip.
val $s = Fleet::Session::open("cat")
Fleet::Session::send_line($s, "alpha")
Fleet::Session::expect($s, qr/alpha/, 10)
Fleet::Session::send_line($s, "beta")
Fleet::Session::expect($s, qr/beta/, 10)
assert_eq join(",", @{ Fleet::Session::matches($s) }), "alpha,beta", "integration: matches recorded in order"
assert_eq Fleet::Session::last_match($s),               "beta",       "integration: last_match is most recent"
assert_ok !Fleet::Session::timed_out($s),                             "integration: no timeout on clean run"
assert_eq scalar(@{ Fleet::Session::events($s, "send") }), 2,         "integration: two send events"
Fleet::Session::close($s)
assert_match qr/close\tcat/, Fleet::Session::transcript_text($s),     "integration: transcript_text shows close"

# 3. Fanout summarize over an all-ok run and an all-fail run. (A mixed
# run is avoided: the PTY line discipline echoes input, so a dead target
# still "matches" an input-derived pattern — process death is not a
# reliable failure signal here.)
val $ok_res = Fleet::Fanout::run(["cat", "cat"], [
    +{ send => "ping\n" },
    +{ expect => qr/ping/, timeout => 5, name => "echo" },
])
val $ok_sum = Fleet::Fanout::summarize($ok_res)
assert_eq $ok_sum->{total},  2, "integration: all-ok fanout total"
assert_eq $ok_sum->{ok},     2, "integration: all-ok fanout both ok"
assert_eq $ok_sum->{failed}, 0, "integration: all-ok fanout none failed"

val $bad_res = Fleet::Fanout::run(["cat", "cat"], [
    +{ expect => qr/never-appears/, timeout => 1, name => "ghost" },
])
val $bad_sum = Fleet::Fanout::summarize($bad_res)
assert_eq $bad_sum->{failed}, 2, "integration: all-fail fanout both failed"
assert_match qr/ghost/, $bad_sum->{errors}[0], "integration: summarize names the failed step"
val $fixed = Fleet::Fanout::retry_failed($bad_res, [ +{ send => "ok\n" } ])
assert_ok $fixed->[0]{retried}, "integration: retry_failed re-ran the failures"

test_run
