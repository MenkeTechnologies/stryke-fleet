## lib/Fanout.stk — `use Fleet::Fanout`
##
## The part Tcl/Expect never had: run one playbook against N targets
## in parallel. Each target gets its own PTY session on its own thread
## (stryke `pmap`); results come back in target order.
##
##   # 50 hosts, one playbook, wall-clock of the slowest host:
##   val $results = Fleet::Fanout::run(
##       [map { "ssh $_" } @hosts],
##       Fleet::Recipes::ssh_login(+{password => $pw}),
##   )
##   p "$_->{cmd}: " . ($_->{ok} ? "ok" : $_->{error}) for @$results

package Fleet::Fanout

## Run \@steps against every command in \@cmds concurrently. Returns an
## arrayref of Fleet::Playbook::run result hashrefs, in \@cmds order.
## opts are passed through to Playbook::run (e.g. +{timeout => 10}).
fn Fleet::Fanout::run ($cmds, $steps, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout: cmds must be an arrayref" unless ref($cmds) eq "ARRAY"
    Fleet::Playbook::validate($steps)
    [ pmap { Fleet::Playbook::run($_, $steps, $opts) } @$cmds ]
}

## ssh convenience: fan \@steps out over \@hosts as `ssh HOST`. opts:
## user (login name), ssh_opts (extra flags string), plus Playbook opts.
fn Fleet::Fanout::ssh ($hosts, $steps, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout: hosts must be an arrayref" unless ref($hosts) eq "ARRAY"
    val $flags = defined $opts->{ssh_opts} ? $opts->{ssh_opts} . " " : ""
    val $user  = defined $opts->{user}     ? $opts->{user} . "@"     : ""
    Fleet::Fanout::run([map { "ssh ${flags}${user}$_" } @$hosts], $steps, $opts)
}

## Partition an arrayref of fan-out results: +{ok => [...], failed => [...]}.
fn Fleet::Fanout::partition ($results) {
    +{
        ok     => [grep {  $_->{ok} } @$results],
        failed => [grep { !$_->{ok} } @$results],
    }
}

## One-line-per-failure report over fan-out results:
##   +{ total, ok, failed, errors => ["CMD: ERROR", ...] }
fn Fleet::Fanout::summarize ($results) {
    val $part = Fleet::Fanout::partition($results)
    +{
        total  => scalar(@$results),
        ok     => scalar(@{ $part->{ok} }),
        failed => scalar(@{ $part->{failed} }),
        errors => [ map { "$_->{cmd}: " . ($_->{error} // "?") } @{ $part->{failed} } ],
    }
}

## Bucket failed fan-out results by their error string → a hashref of
## { "error message" => [cmd, ...] }. At fleet scale this collapses the flat
## per-host error list `summarize` returns into "which hosts failed the same
## way" — the first thing you want when 200 targets misbehave. Successful
## results are ignored.
fn Fleet::Fanout::group_by_error ($results) {
    val $failed = Fleet::Fanout::partition($results)->{failed}
    var %buckets
    for val $r (@$failed) {
        val $key = $r->{error} // "?"
        if (exists $buckets{$key}) {
            push @{ $buckets{$key} }, $r->{cmd}
        } else {
            $buckets{$key} = [ $r->{cmd} ]
        }
    }
    \%buckets
}

## Re-run \@steps against just the failed entries of a previous fan-out,
## in place: ok results pass through untouched, failed ones are replaced
## by their re-run result (tagged retried => 1). Order is preserved.
fn Fleet::Fanout::retry_failed ($results, $steps, $opts = undef) {
    $opts //= +{}
    Fleet::Playbook::validate($steps)
    [
        map {
            if ($_->{ok}) {
                $_
            } else {
                val $again = Fleet::Playbook::run($_->{cmd}, $steps, $opts)
                $again->{retried} = 1
                $again
            }
        } @$results
    ]
}
