## lib/Fanout.stk — `use Fleet::Fanout`
##
## The part Tcl/Expect never had: run one playbook against N targets
## in parallel. Each target gets its own PTY session on its own thread
## (stryke `pmap`); results come back in target order.
##
##   # 50 hosts, one playbook, wall-clock of the slowest host:
##   val $results = Fleet::Fanout::run(
##       [map { "ssh $_" } @hosts],
##       Fleet::Recipes::ssh_login(+{password => $pw}),
##   )
##   p "$_->{cmd}: " . ($_->{ok} ? "ok" : $_->{error}) for @$results

package Fleet::Fanout

## Run \@steps against every command in \@cmds concurrently. Returns an
## arrayref of Fleet::Playbook::run result hashrefs, in \@cmds order.
## opts are passed through to Playbook::run (e.g. +{timeout => 10}).
fn Fleet::Fanout::run ($cmds, $steps, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout: cmds must be an arrayref" unless ref($cmds) eq "ARRAY"
    Fleet::Playbook::validate($steps)
    [ pmap { Fleet::Playbook::run($_, $steps, $opts) } @$cmds ]
}

## Run \@steps against \@cmds in consecutive batches of $batch_size — parallel
## within a batch (pmap), sequential between batches. Bounds concurrency so a
## large fleet doesn't exhaust file descriptors or the network the way the
## all-at-once `run` can. Returns the flat result list in \@cmds order; opts
## pass through to Playbook::run.
fn Fleet::Fanout::batch ($cmds, $steps, $batch_size, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout: cmds must be an arrayref" unless ref($cmds) eq "ARRAY"
    die "Fleet::Fanout::batch: batch_size must be >= 1" unless $batch_size >= 1
    Fleet::Playbook::validate($steps)
    val @all = @$cmds
    var @out
    var $i = 0
    while ($i <= $#all) {
        val $last = ($i + $batch_size - 1) < $#all ? ($i + $batch_size - 1) : $#all
        val @group = @all[$i .. $last]
        val @results = pmap { Fleet::Playbook::run($_, $steps, $opts) } @group
        push @out, @results
        $i += $batch_size
    }
    \@out
}

## ssh convenience: fan \@steps out over \@hosts as `ssh HOST`. opts:
## user (login name), ssh_opts (extra flags string), plus Playbook opts.
fn Fleet::Fanout::ssh ($hosts, $steps, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout: hosts must be an arrayref" unless ref($hosts) eq "ARRAY"
    val $flags = defined $opts->{ssh_opts} ? $opts->{ssh_opts} . " " : ""
    val $user  = defined $opts->{user}     ? $opts->{user} . "@"     : ""
    Fleet::Fanout::run([map { "ssh ${flags}${user}$_" } @$hosts], $steps, $opts)
}

## Partition an arrayref of fan-out results: +{ok => [...], failed => [...]}.
fn Fleet::Fanout::partition ($results) {
    +{
        ok     => [grep {  $_->{ok} } @$results],
        failed => [grep { !$_->{ok} } @$results],
    }
}

## Tally fan-out results: +{ total, ok, failed }. The numbers-only core of
## `summarize` (no error lines) — the cheap "how did the fleet do" check when you
## do not need the per-host error strings.
fn Fleet::Fanout::count ($results) {
    var $ok = 0
    for val $r (@$results) { $ok++ if $r->{ok} }
    +{
        total  => scalar(@$results),
        ok     => $ok,
        failed => scalar(@$results) - $ok,
    }
}

## True (1) iff every fan-out result is ok — the boolean gate for "did the whole
## fleet pass". An empty result set is vacuously ok (1). Returns 0 otherwise.
fn Fleet::Fanout::all_ok ($results) {
    for val $r (@$results) { return 0 unless $r->{ok} }
    1
}

## The cmd string of every failed fan-out result, in order — the bare list of
## targets to look at, without the error text `summarize` interleaves. Pairs with
## retry_failed/retry_until when you want to drive the failures yourself.
fn Fleet::Fanout::failed_cmds ($results) {
    [ map { $_->{cmd} } grep { !$_->{ok} } @$results ]
}

## Map a key fn over fan-out results → an arrayref of one extracted value per
## result, order preserved. The projection primitive group_by_output buckets with:
## pluck($results, fn ($r) { $r->{version} }) is "just the versions, in host
## order". $key is required and called once per result.
fn Fleet::Fanout::pluck ($results, $key) {
    die "Fleet::Fanout::pluck: key must be a coderef" unless ref($key) eq "CODE"
    [ map { $key->($_) } @$results ]
}

## The cmd string of every OK fan-out result, in order — the complement of
## `failed_cmds`. The bare list of targets that passed, for a "now run the next
## stage only against the hosts that succeeded" hand-off.
fn Fleet::Fanout::ok_cmds ($results) {
    [ map { $_->{cmd} } grep { $_->{ok} } @$results ]
}

## Find the FIRST fan-out result whose cmd matches $pattern (a regex string or
## qr//) — the by-target lookup over a result list (results come back in cmd
## order, not keyed). Returns the result hashref, or undef when no cmd matches.
fn Fleet::Fanout::find ($results, $pattern) {
    val $re = ref($pattern) eq "Regexp" ? $pattern : qr/$pattern/
    for val $r (@$results) {
        return $r if ($r->{cmd} // "") =~ $re
    }
    undef
}

## Bucket ALL fan-out results by a $key fn → a hashref { "key value" => [cmd, ...] }
## with cmd order preserved within each bucket. The general grouping primitive that
## group_by_error (failures by error) and group_by_output (successes by output)
## specialize: pass any key fn to slice the fleet however you need —
## group_by($results, fn ($r) { $r->{ok} ? "ok" : "fail" }) for the pass/fail split,
## or a captured field for an arbitrary pivot. $key is required and called once per
## result; an undef key is bucketed under "".
fn Fleet::Fanout::group_by ($results, $key) {
    die "Fleet::Fanout::group_by: key must be a coderef" unless ref($key) eq "CODE"
    var %buckets
    for val $r (@$results) {
        var $k = $key->($r)
        $k //= ""
        if (exists $buckets{$k}) {
            push @{ $buckets{$k} }, $r->{cmd}
        } else {
            $buckets{$k} = [ $r->{cmd} ]
        }
    }
    \%buckets
}

## Map a $key fn over only the OK fan-out results → an arrayref of one extracted
## value per success, order preserved — the `pluck` that skips failures. The clean
## "just the versions from the hosts that answered" projection, without the undefs
## that plucking a captured field off a failed result would yield. $key is required
## and called once per ok result.
fn Fleet::Fanout::pluck_ok ($results, $key) {
    die "Fleet::Fanout::pluck_ok: key must be a coderef" unless ref($key) eq "CODE"
    [ map { $key->($_) } grep { $_->{ok} } @$results ]
}

## One-line-per-failure report over fan-out results:
##   +{ total, ok, failed, errors => ["CMD: ERROR", ...] }
fn Fleet::Fanout::summarize ($results) {
    val $part = Fleet::Fanout::partition($results)
    +{
        total  => scalar(@$results),
        ok     => scalar(@{ $part->{ok} }),
        failed => scalar(@{ $part->{failed} }),
        errors => [ map { "$_->{cmd}: " . ($_->{error} // "?") } @{ $part->{failed} } ],
    }
}

## Bucket failed fan-out results by their error string → a hashref of
## { "error message" => [cmd, ...] }. At fleet scale this collapses the flat
## per-host error list `summarize` returns into "which hosts failed the same
## way" — the first thing you want when 200 targets misbehave. Successful
## results are ignored.
fn Fleet::Fanout::group_by_error ($results) {
    val $failed = Fleet::Fanout::partition($results)->{failed}
    var %buckets
    for val $r (@$failed) {
        val $key = $r->{error} // "?"
        if (exists $buckets{$key}) {
            push @{ $buckets{$key} }, $r->{cmd}
        } else {
            $buckets{$key} = [ $r->{cmd} ]
        }
    }
    \%buckets
}

## Bucket fan-out results by their captured OUTPUT — fleet config-drift
## detection. Among the targets that succeeded, group by a comparable output
## value so the outliers stand out ("47 hosts returned X, 3 returned Y"). The
## default key is each result's last transcript `data` event (the command's
## final output); pass a $key fn to extract something finer (a captured field,
## one line). Returns a hashref { "value" => [cmd, ...] }, cmd order preserved.
## Unlike group_by_error (which buckets FAILURES by error string), this buckets
## SUCCESSES by output — the first thing you check when auditing a fleet.
fn Fleet::Fanout::group_by_output ($results, $key = undef) {
    var %buckets
    for val $r (@$results) {
        if ($r->{ok}) {
            var $val = undef
            if (defined $key) {
                $val = $key->($r)
            } else {
                val @ev = @{ $r->{transcript} // [] }
                $val = @ev ? ($ev[$#ev]{data} // "") : ""
            }
            $val //= ""
            if (exists $buckets{$val}) {
                push @{ $buckets{$val} }, $r->{cmd}
            } else {
                $buckets{$val} = [ $r->{cmd} ]
            }
        }
    }
    \%buckets
}

## Find which fan-out targets saw $pattern in their captured output. Scans every
## result's transcript events for a `data` field matching $pattern (a regex
## string or qr//) and returns an arrayref of +{ cmd, ok, match } — match is the
## first matching event data. This is the fleet-scale "which hosts printed X"
## query; unlike partition/summarize/group_by_error it searches the transcript,
## not just ok/error, so it catches things that did not fail the playbook (a
## deprecation warning, a version banner, an unexpected prompt).
fn Fleet::Fanout::grep_transcript ($results, $pattern) {
    val $re = ref($pattern) eq "Regexp" ? $pattern : qr/$pattern/
    var @out
    for val $r (@$results) {
        var $hit = undef
        for val $ev (@{ $r->{transcript} // [] }) {
            val $d = $ev->{data} // ""
            if ($d =~ $re) {
                $hit = $d
                last
            }
        }
        push @out, +{ cmd => $r->{cmd}, ok => $r->{ok}, match => $hit } if defined $hit
    }
    \@out
}

## Re-run \@steps against just the failed entries of a previous fan-out,
## in place: ok results pass through untouched, failed ones are replaced
## by their re-run result (tagged retried => 1). Order is preserved.
fn Fleet::Fanout::retry_failed ($results, $steps, $opts = undef) {
    $opts //= +{}
    Fleet::Playbook::validate($steps)
    [
        map {
            if ($_->{ok}) {
                $_
            } else {
                val $again = Fleet::Playbook::run($_->{cmd}, $steps, $opts)
                $again->{retried} = 1
                $again
            }
        } @$results
    ]
}

## Re-run each failed entry up to $max_attempts times, stopping per-target the
## moment it succeeds — the persistent-retry form of retry_failed for transient
## failures. An entry that needed retries carries `retried => 1` and `attempts`
## => how many re-runs it took. ok results pass through untouched (no attempts).
## Order is preserved. $max_attempts must be >= 1.
fn Fleet::Fanout::retry_until ($results, $steps, $max_attempts, $opts = undef) {
    $opts //= +{}
    die "Fleet::Fanout::retry_until: max_attempts must be >= 1" unless $max_attempts >= 1
    Fleet::Playbook::validate($steps)
    [
        map {
            var $r = $_
            var $n = 0
            while (!$r->{ok} && $n < $max_attempts) {
                $r = Fleet::Playbook::run($r->{cmd}, $steps, $opts)
                $n++
            }
            if ($n > 0) {
                $r->{retried}  = 1
                $r->{attempts} = $n
            }
            $r
        } @$results
    ]
}
