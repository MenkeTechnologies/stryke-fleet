## lib/Playbook.stk — `use Fleet::Playbook`
##
## Declarative expect/send automation. A playbook is an arrayref of
## step hashrefs executed in order against one PTY session:
##
##   +{ expect => qr/password:/, send => "$pw\n", timeout => 10 }
##   +{ send => "uptime\n" }                       # send-only
##   +{ expect => qr/\$/, name => "shell prompt" } # expect-only
##   +{ branches => [+{re => qr/yes\/no/, do => fn { "yes\n" }},
##                   +{re => qr/password:/}],      # first match wins
##      send_matched => 1 }                        # send the branch result
##   +{ expect => qr/motd/, optional => 1 }        # timeout ≠ failure
##
## Step keys: expect, branches, send, send_matched, timeout (seconds,
## default 30), name (for diagnostics), optional (continue on timeout),
## retries (re-attempt a timed-out expect/branch N more times),
## retry_send (string sent before each retry — a nudge like "\n"),
## delay (seconds to sleep before the step runs; fractional ok).
## Every step must have at least one of expect / branches / send.

package Fleet::Playbook

use Fleet::Session

## Die unless \@steps is a well-formed playbook. Returns step count.
fn Fleet::Playbook::validate ($steps) {
    die "Fleet::Playbook: steps must be an arrayref" unless ref($steps) eq "ARRAY"
    var $i = 0
    for my $st (@$steps) {
        die "Fleet::Playbook: step $i is not a hashref" unless ref($st) eq "HASH"
        unless (defined $st->{expect} || defined $st->{branches} || defined $st->{send}) {
            die "Fleet::Playbook: step $i needs expect, branches, or send"
        }
        if (defined $st->{branches} && ref($st->{branches}) ne "ARRAY") {
            die "Fleet::Playbook: step $i branches must be an arrayref"
        }
        if (defined $st->{retries} && ($st->{retries} !~ /^\d+$/ || $st->{retries} < 0)) {
            die "Fleet::Playbook: step $i retries must be a non-negative integer"
        }
        if (defined $st->{delay} && $st->{delay} < 0) {
            die "Fleet::Playbook: step $i delay must be >= 0"
        }
        $i++
    }
    scalar @$steps
}

## Human-readable step listing — name, action, timeout per line. Pure:
## validates but never spawns. Drives `fleet.stk` previews.
fn Fleet::Playbook::dry_run ($steps) {
    Fleet::Playbook::validate($steps)
    var @lines
    var $i = 0
    for my $st (@$steps) {
        val $name = $st->{name} // "step $i"
        var @what
        push @what, "expect " . ($st->{expect} // "")          if defined $st->{expect}
        push @what, scalar(@{ $st->{branches} }) . " branches" if defined $st->{branches}
        push @what, "send " . length($st->{send}) . "b"        if defined $st->{send}
        push @what, "delay $st->{delay}s"                      if defined $st->{delay}
        push @what, "retries $st->{retries}"                   if defined $st->{retries}
        push @what, "optional"                                 if $st->{optional}
        push @lines, sprintf("%2d  %-24s %s", $i, $name, join(", ", @what))
        $i++
    }
    join("\n", @lines)
}

## Splice several step-lists into one playbook and validate the result. Takes
## any number of arrayrefs (recipes return these) and concatenates them in order,
## the explicit form of the `(@{ $a }, @{ $b }, ...)` splice the recipes README
## shows. Validates the combined list and returns the flat arrayref, ready for
## `run`. Dies (via validate) if any element is not a well-formed step.
fn Fleet::Playbook::concat (@parts) {
    var @steps
    for val $p (@parts) {
        next unless defined $p
        die "Fleet::Playbook::concat: each part must be an arrayref" unless ref($p) eq "ARRAY"
        push @steps, @$p
    }
    Fleet::Playbook::validate(\@steps)
    \@steps
}

## Run \@steps against CMD (string → session spawned here, hashref →
## an already-open Fleet::Session). Returns the result hashref:
##
##   +{ ok => 0|1, cmd, steps_run, transcript,
##      failed_step => N, error => "..." }      # only when ok == 0
##
## A non-optional expect/branch timeout fails the run; the session is
## always closed (unless the caller passed it in already open).
fn Fleet::Playbook::run ($cmd, $steps, $opts = undef) {
    $opts //= +{}
    Fleet::Playbook::validate($steps)
    val $own = ref($cmd) ne "HASH"
    val $s   = $own ? Fleet::Session::open($cmd) : $cmd
    var $i   = 0
    var $err = undef
    for my $st (@$steps) {
        val $timeout = $st->{timeout} // ($opts->{timeout} // 30)
        sleep $st->{delay} if defined $st->{delay} && $st->{delay} > 0
        val $attempts = 1 + ($st->{retries} // 0)
        if (defined $st->{expect}) {
            var $m = undef
            for var $try (1 .. $attempts) {
                Fleet::Session::send($s, $st->{retry_send}) if $try > 1 && defined $st->{retry_send}
                $m = Fleet::Session::expect($s, $st->{expect}, $timeout)
                last if defined $m
            }
            if (!defined $m && !$st->{optional}) {
                $err = "timeout on " . ($st->{name} // "step $i")
                last
            }
        } elsif (defined $st->{branches}) {
            var $m = undef
            for var $try (1 .. $attempts) {
                Fleet::Session::send($s, $st->{retry_send}) if $try > 1 && defined $st->{retry_send}
                $m = Fleet::Session::branch($s, $st->{branches}, $timeout)
                last if defined $m
            }
            if (!defined $m && !$st->{optional}) {
                $err = "timeout on " . ($st->{name} // "step $i")
                last
            }
            Fleet::Session::send($s, $m) if defined $m && $st->{send_matched}
        }
        Fleet::Session::send($s, $st->{send}) if defined $st->{send}
        $i++
    }
    Fleet::Session::close($s) if $own
    val $r = +{
        ok         => defined $err ? 0 : 1,
        cmd        => $s->{cmd},
        steps_run  => $i,
        transcript => Fleet::Session::transcript($s),
    }
    if (defined $err) {
        $r->{failed_step} = $i
        $r->{error}       = $err
    }
    $r
}
