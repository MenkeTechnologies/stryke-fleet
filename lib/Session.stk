## lib/Session.stk — `use Fleet::Session`
##
## Transcripted PTY session: a hashref wrapping the raw pty_* handle
## that records every send and every match, so a finished session can
## be audited (`transcript`) or dumped on failure. The bare builtins
## stay available — this layer only adds bookkeeping.
##
##   val $s = Fleet::Session::open("ssh user\@host")
##   Fleet::Session::expect($s, qr/password:/, 10)
##   Fleet::Session::send($s, "$pw\n")
##   Fleet::Session::close($s)
##   p $_->{event} . " " . $_->{data} for @{ Fleet::Session::transcript($s) }

package Fleet::Session

## Spawn CMD under a PTY. Returns the session hashref:
## +{ raw => <pty handle>, cmd => CMD, log => [] }.
fn Fleet::Session::open ($cmd) {
    +{ raw => pty_spawn($cmd), cmd => $cmd, log => [] }
}

## Send text to the session's stdin. Logged as a `send` event.
fn Fleet::Session::send ($s, $text) {
    push @{ $s->{log} }, +{ event => "send", data => $text }
    pty_send($s->{raw}, $text)
}

## Wait for PATTERN (qr// or string) in the output. Returns the matched
## text, or undef on timeout. Both outcomes are logged.
fn Fleet::Session::expect ($s, $pat, $timeout = undef) {
    $timeout //= 30
    val $m = pty_expect($s->{raw}, $pat, $timeout)
    push @{ $s->{log} },
        defined $m ? +{ event => "match",   data => $m }
                   : +{ event => "timeout", data => "$pat" }
    $m
}

## First-match-wins branch table — \@branches is
## [+{re => qr/.../, do => fn {...}}, ...] (the `do` coderef is
## optional). Returns the action's return value when present, else the
## matched text; undef on timeout.
fn Fleet::Session::branch ($s, $branches, $timeout = undef) {
    $timeout //= 30
    val $hit = pty_expect_table($s->{raw}, $branches, $timeout)
    unless (defined $hit) {
        push @{ $s->{log} }, +{ event => "timeout", data => "branch" }
        return undef
    }
    push @{ $s->{log} }, +{ event => "match", data => $hit->{matched} }
    val $action = $hit->{action}
    return $hit->{matched} unless ref($action) eq "CODE"
    $action->($hit->{matched})
}

## Drain whatever output is buffered right now (non-matching read).
fn Fleet::Session::read ($s, $timeout = undef) { pty_read($s->{raw}, $timeout // 5) }

## Current unconsumed output buffer.
fn Fleet::Session::buffer ($s) { pty_buffer($s->{raw}) }

## Process still running?
fn Fleet::Session::alive ($s) { pty_alive($s->{raw}) }

## Child closed its side?
fn Fleet::Session::eof ($s) { pty_eof($s->{raw}) }

## Hand the PTY to the user (debugging).
fn Fleet::Session::interact ($s) { pty_interact($s->{raw}) }

## Kill the child and release the PTY. Logged as a `close` event.
fn Fleet::Session::close ($s) {
    push @{ $s->{log} }, +{ event => "close", data => $s->{cmd} }
    pty_close($s->{raw})
}

## The ordered event log: arrayref of +{event, data} hashrefs, where
## event is one of send / match / timeout / close.
fn Fleet::Session::transcript ($s) { $s->{log} }

## Send text with a guaranteed trailing newline — the common case for
## answering a prompt. Logged as a `send` event like `send`.
fn Fleet::Session::send_line ($s, $text) {
    val $line = substr($text, -1) eq "\n" ? $text : "$text\n"
    Fleet::Session::send($s, $line)
}

## Send a secret (password, token) WITHOUT logging it — the transcript records a
## redacted `send` event (data "***", secret => 1) so credentials never leak into
## transcript dumps or failure reports. A trailing newline is added (the common
## case for answering a password prompt) unless $text already ends in one. The
## secret is still transmitted in full to the session's stdin.
fn Fleet::Session::send_secret ($s, $text) {
    val $line = substr($text, -1) eq "\n" ? $text : "$text\n"
    push @{ $s->{log} }, +{ event => "send", data => "***", secret => 1 }
    pty_send($s->{raw}, $line)
}

## Send a control character to the session — the pexpect/Expect `sendcontrol`
## primitive. $char is a single letter a-z (Ctrl-A … Ctrl-Z, e.g. "c" → 0x03 to
## interrupt, "d" → 0x04 for EOF, "z" → 0x1a to suspend) or one of the symbol
## controls @[\]^_? (`[` → ESC 0x1b, `?` → DEL 0x7f). The transcript records a
## `send_control` event with the char + byte (the raw byte is never dumped). An
## unknown char dies.
fn Fleet::Session::send_control ($s, $char) {
    val $c = lc(substr($char, 0, 1))
    val %special = ('@' => 0, '[' => 27, '\\' => 28, ']' => 29, '^' => 30, '_' => 31, '?' => 127)
    var $byte
    if ($c =~ /^[a-z]$/) {
        $byte = ord($c) - 96
    } elsif (exists $special{$c}) {
        $byte = $special{$c}
    } else {
        die "Fleet::Session::send_control: unknown control char '$char' (want a-z or \@[\\]^_?)"
    }
    push @{ $s->{log} }, +{ event => "send_control", char => $c, byte => $byte }
    pty_send($s->{raw}, chr($byte))
}

## Transcript entries of one event type (send / match / timeout /
## close), in order. events($s, "match") → the matched-text entries.
fn Fleet::Session::events ($s, $type) {
    [ grep { $_->{event} eq $type } @{ $s->{log} } ]
}

## The data of every `match` event, in order — the texts this session
## matched. Pure read over the transcript.
fn Fleet::Session::matches ($s) {
    [ map { $_->{data} } grep { $_->{event} eq "match" } @{ $s->{log} } ]
}

## The data of the most recent `match` event, or undef if none yet.
fn Fleet::Session::last_match ($s) {
    var $last = undef
    for val $e (@{ $s->{log} }) {
        $last = $e->{data} if $e->{event} eq "match"
    }
    $last
}

## True if any expect/branch in this session has timed out. Catches a
## degraded run even when an `optional` step let the playbook continue.
fn Fleet::Session::timed_out ($s) {
    (scalar @{ Fleet::Session::events($s, "timeout") }) > 0 ? 1 : 0
}

## Render the transcript as one "EVENT<TAB>DATA" line per event — the
## human-readable dump for a failed session. Newlines in data are
## escaped so each event stays on its own line.
fn Fleet::Session::transcript_text ($s) {
    join "\n", map {
        val $d = $_->{data} =~ s/\n/\\n/gr
        "$_->{event}\t$d"
    } @{ $s->{log} }
}
