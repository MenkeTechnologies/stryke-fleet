## lib/Recipes.stk — `use Fleet::Recipes`
##
## Step-list generators for the interactive sessions everyone scripts
## by hand: ssh login chains, sudo, database CLIs, yes/no installers,
## network-gear enable mode. Each recipe returns a plain playbook
## arrayref — pure data, composable with `@{...}` splices:
##
##   val @steps = (@{ Fleet::Recipes::ssh_login(+{password => $pw}) },
##                 +{ send => "uptime\n" },
##                 +{ expect => qr/\$/ })
##   Fleet::Playbook::run("ssh user\@host", \@steps)
##
## Recipes never spawn anything themselves — they only build steps, so
## they are unit-testable without a network or a target host.

package Fleet::Recipes

## SSH login: optional host-key confirmation, optional password prompt,
## then a shell prompt. opts: password, prompt (qr//, default qr/[$#%>] ?$/m),
## timeout.
fn Fleet::Recipes::ssh_login ($opts = undef) {
    $opts //= +{}
    val $prompt  = $opts->{prompt}  // qr/[\$#%>] ?$/m
    val $timeout = $opts->{timeout} // 30
    var @steps = (
        +{
            name     => "host key / password",
            branches => [
                +{ re => qr/\(yes\/no(?:\/\[fingerprint\])?\)\?/, do => fn { "yes\n" } },
                +{ re => qr/[Pp]assword:/ },
                +{ re => $prompt },
            ],
            send_matched => 0,
            timeout      => $timeout,
            optional     => 1,
        },
    )
    if (defined $opts->{password}) {
        push @steps, +{
            name     => "password",
            expect   => qr/[Pp]assword:/,
            send     => $opts->{password} . "\n",
            timeout  => $timeout,
            optional => 1,
        }
    }
    push @steps, +{ name => "shell prompt", expect => $prompt, timeout => $timeout }
    [@steps]
}

## sudo: answer the password prompt, then expect PROMPT. opts: password
## (required), prompt, timeout.
fn Fleet::Recipes::sudo ($opts) {
    die "Fleet::Recipes::sudo: password required" unless defined $opts->{password}
    val $prompt = $opts->{prompt} // qr/[\$#%>] ?$/m
    [
        +{
            name    => "sudo password",
            expect  => qr/\[sudo\] password|[Pp]assword:/,
            send    => $opts->{password} . "\n",
            timeout => $opts->{timeout} // 15,
        },
        +{ name => "post-sudo prompt", expect => $prompt, timeout => $opts->{timeout} // 15 },
    ]
}

## psql: optional password prompt, then the `db=#` prompt. opts:
## password, timeout.
fn Fleet::Recipes::psql ($opts = undef) {
    $opts //= +{}
    var @steps
    if (defined $opts->{password}) {
        push @steps, +{
            name     => "psql password",
            expect   => qr/Password.*:/,
            send     => $opts->{password} . "\n",
            timeout  => $opts->{timeout} // 15,
            optional => 1,
        }
    }
    push @steps, +{ name => "psql prompt", expect => qr/=[#>] ?$/m, timeout => $opts->{timeout} // 15 }
    [@steps]
}

## mysql: optional password prompt, then the `mysql>` prompt. opts:
## password, timeout.
fn Fleet::Recipes::mysql ($opts = undef) {
    $opts //= +{}
    var @steps
    if (defined $opts->{password}) {
        push @steps, +{
            name     => "mysql password",
            expect   => qr/Enter password:/,
            send     => $opts->{password} . "\n",
            timeout  => $opts->{timeout} // 15,
            optional => 1,
        }
    }
    push @steps, +{ name => "mysql prompt", expect => qr/mysql> ?$/m, timeout => $opts->{timeout} // 15 }
    [@steps]
}

## redis-cli: expect the `host:port>` prompt; optional AUTH. opts:
## password, timeout.
fn Fleet::Recipes::redis_cli ($opts = undef) {
    $opts //= +{}
    val $timeout = $opts->{timeout} // 15
    var @steps = ( +{ name => "redis prompt", expect => qr/:\d+> ?$/m, timeout => $timeout } )
    if (defined $opts->{password}) {
        push @steps,
            +{ name => "auth",    send   => "AUTH " . $opts->{password} . "\n" },
            +{ name => "auth ok", expect => qr/OK/, timeout => $timeout }
    }
    [@steps]
}

## Interactive installers: answer up to COUNT yes/no-style prompts with
## ANSWER (default "y"), tolerating runs that ask fewer questions.
fn Fleet::Recipes::yes_to_all ($count = undef, $answer = undef) {
    $count //= 10
    $answer //= "y"
    [
        map {
            +{
                name     => "prompt $_",
                expect   => qr/\[[YyNn]\/[YyNn]\]|\(y(?:es)?\/no?\)|\? ?$/m,
                send     => $answer . "\n",
                optional => 1,
                timeout  => 5,
            }
        } 1 .. $count
    ]
}

## Cisco-style enable mode: `>` prompt → enable → password → `#`. opts:
## enable_password (required), timeout.
fn Fleet::Recipes::cisco_enable ($opts) {
    unless (defined $opts->{enable_password}) {
        die "Fleet::Recipes::cisco_enable: enable_password required"
    }
    val $timeout = $opts->{timeout} // 15
    [
        +{ name => "exec prompt",     expect => qr/> ?$/m, timeout => $timeout },
        +{ name => "enable",          send   => "enable\n" },
        +{ name => "enable password", expect => qr/[Pp]assword:/, send => $opts->{enable_password} . "\n", timeout => $timeout },
        +{ name => "priv prompt",     expect => qr/# ?$/m, timeout => $timeout },
    ]
}

## su: switch user — answer the password prompt, then expect PROMPT.
## opts: password (required), prompt, timeout.
fn Fleet::Recipes::su ($opts) {
    die "Fleet::Recipes::su: password required" unless defined $opts->{password}
    val $prompt  = $opts->{prompt}  // qr/[\$#%>] ?$/m
    val $timeout = $opts->{timeout} // 15
    [
        +{
            name    => "su password",
            expect  => qr/[Pp]assword:/,
            send    => $opts->{password} . "\n",
            timeout => $timeout,
        },
        +{ name => "post-su prompt", expect => $prompt, timeout => $timeout },
    ]
}

## telnet login: `login:` → user, `Password:` → password, then PROMPT.
## opts: user (required), password (required), prompt, timeout.
fn Fleet::Recipes::telnet_login ($opts) {
    die "Fleet::Recipes::telnet_login: user required"     unless defined $opts->{user}
    die "Fleet::Recipes::telnet_login: password required" unless defined $opts->{password}
    val $prompt  = $opts->{prompt}  // qr/[\$#%>] ?$/m
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "login prompt",    expect => qr/login: ?$/mi,   send => $opts->{user} . "\n",     timeout => $timeout },
        +{ name => "telnet password", expect => qr/[Pp]assword: ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "shell prompt",    expect => $prompt, timeout => $timeout },
    ]
}

## sftp: optional host-key confirmation, optional password, then the
## `sftp>` prompt. opts: password, timeout. Mirrors ssh_login's
## branch-table opener.
fn Fleet::Recipes::sftp ($opts = undef) {
    $opts //= +{}
    val $timeout = $opts->{timeout} // 30
    var @steps = (
        +{
            name     => "host key / password",
            branches => [
                +{ re => qr/\(yes\/no(?:\/\[fingerprint\])?\)\?/, do => fn { "yes\n" } },
                +{ re => qr/[Pp]assword:/ },
                +{ re => qr/sftp> ?$/m },
            ],
            send_matched => 0,
            timeout      => $timeout,
            optional     => 1,
        },
    )
    if (defined $opts->{password}) {
        push @steps, +{
            name     => "sftp password",
            expect   => qr/[Pp]assword:/,
            send     => $opts->{password} . "\n",
            timeout  => $timeout,
            optional => 1,
        }
    }
    push @steps, +{ name => "sftp prompt", expect => qr/sftp> ?$/m, timeout => $timeout }
    [@steps]
}

## passwd: the classic expect chain — optional current password (root
## skips it), new password, retype, success message. opts: new_password
## (required), old_password, timeout.
fn Fleet::Recipes::passwd_change ($opts) {
    unless (defined $opts->{new_password}) {
        die "Fleet::Recipes::passwd_change: new_password required"
    }
    val $timeout = $opts->{timeout} // 15
    var @steps
    if (defined $opts->{old_password}) {
        push @steps, +{
            name     => "current password",
            expect   => qr/(?:[Cc]urrent|[Oo]ld|\(current\)).*[Pp]assword: ?/,
            send     => $opts->{old_password} . "\n",
            timeout  => $timeout,
            optional => 1,
        }
    }
    push @steps,
        +{ name => "new password",    expect => qr/[Nn]ew.*[Pp]assword: ?/, send => $opts->{new_password} . "\n", timeout => $timeout },
        +{ name => "retype password", expect => qr/(?:[Rr]etype|[Rr]e-enter|again).*[Pp]assword: ?|[Nn]ew.*[Pp]assword: ?/, send => $opts->{new_password} . "\n", timeout => $timeout },
        +{ name => "passwd success",  expect => qr/successfully|updated/i, timeout => $timeout }
    [@steps]
}

## docker login: `Username:` → user, `Password:` → password, then the
## success line. opts: user (required), password (required), timeout.
fn Fleet::Recipes::docker_login ($opts) {
    die "Fleet::Recipes::docker_login: user required"     unless defined $opts->{user}
    die "Fleet::Recipes::docker_login: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "username", expect => qr/[Uu]sername: ?/, send => $opts->{user} . "\n",     timeout => $timeout, optional => 1 },
        +{ name => "password", expect => qr/[Pp]assword: ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "login ok", expect => qr/Login Succeeded/i, timeout => $timeout },
    ]
}

## scp: optional host-key confirmation then a password prompt — the
## copy runs to completion on its own. opts: password (required), timeout.
fn Fleet::Recipes::scp ($opts) {
    die "Fleet::Recipes::scp: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{
            name     => "host key",
            expect   => qr/\(yes\/no(?:\/\[fingerprint\])?\)\?/,
            send     => "yes\n",
            timeout  => $timeout,
            optional => 1,
        },
        +{ name => "scp password", expect => qr/[Pp]assword:/, send => $opts->{password} . "\n", timeout => $timeout },
    ]
}

## gpg --decrypt / symmetric: answer the passphrase prompt. opts:
## passphrase (required), timeout. gpg prompts on its tty/pinentry-curses.
fn Fleet::Recipes::gpg_decrypt ($opts) {
    die "Fleet::Recipes::gpg_decrypt: passphrase required" unless defined $opts->{passphrase}
    val $timeout = $opts->{timeout} // 20
    [
        +{ name => "gpg passphrase", expect => qr/[Pp]assphrase/, send => $opts->{passphrase} . "\n", timeout => $timeout },
    ]
}

## ftp interactive login: `Name:` → user, `Password:` → password, then
## the `ftp>` prompt. opts: user (required), password (required), timeout.
fn Fleet::Recipes::ftp_login ($opts) {
    die "Fleet::Recipes::ftp_login: user required"     unless defined $opts->{user}
    die "Fleet::Recipes::ftp_login: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "ftp name",     expect => qr/Name.*: ?/,     send => $opts->{user} . "\n",     timeout => $timeout },
        +{ name => "ftp password", expect => qr/[Pp]assword: ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "ftp prompt",   expect => qr/ftp> ?$/m, timeout => $timeout },
    ]
}

## openssl PEM passphrase entry with verification — the classic
## "Enter PEM pass phrase:" / "Verifying - Enter PEM pass phrase:"
## dance (openssl genrsa -aes256, req, etc.). opts: passphrase
## (required), timeout.
fn Fleet::Recipes::openssl_pem ($opts) {
    die "Fleet::Recipes::openssl_pem: passphrase required" unless defined $opts->{passphrase}
    val $timeout = $opts->{timeout} // 15
    [
        +{ name => "pem passphrase", expect => qr/Enter PEM pass ?phrase:/i,            send => $opts->{passphrase} . "\n", timeout => $timeout },
        +{ name => "pem verify",     expect => qr/Verifying.*Enter PEM pass ?phrase:/i, send => $opts->{passphrase} . "\n", timeout => $timeout },
    ]
}

## mongo shell: optional password prompt, then the `>` / `rs0:PRIMARY>`
## prompt. opts: password, timeout.
fn Fleet::Recipes::mongo ($opts = undef) {
    $opts //= +{}
    val $timeout = $opts->{timeout} // 15
    var @steps
    if (defined $opts->{password}) {
        push @steps, +{
            name     => "mongo password",
            expect   => qr/Enter password:/i,
            send     => $opts->{password} . "\n",
            timeout  => $timeout,
            optional => 1,
        }
    }
    push @steps, +{ name => "mongo prompt", expect => qr/>\s?$/m, timeout => $timeout }
    [@steps]
}

## npm login (legacy interactive): Username / Password / Email prompts.
## opts: user (required), password (required), email (required), timeout.
fn Fleet::Recipes::npm_login ($opts) {
    die "Fleet::Recipes::npm_login: user required"     unless defined $opts->{user}
    die "Fleet::Recipes::npm_login: password required" unless defined $opts->{password}
    die "Fleet::Recipes::npm_login: email required"    unless defined $opts->{email}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "npm username", expect => qr/[Uu]sername: ?/, send => $opts->{user} . "\n",     timeout => $timeout },
        +{ name => "npm password", expect => qr/[Pp]assword: ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "npm email",    expect => qr/[Ee]mail.*: ?/,  send => $opts->{email} . "\n",    timeout => $timeout },
    ]
}

## rsync over ssh — host-key accept then password (same prompts as scp).
fn Fleet::Recipes::rsync ($opts) {
    die "Fleet::Recipes::rsync: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{
            name     => "host key",
            expect   => qr/\(yes\/no(?:\/\[fingerprint\])?\)\?/,
            send     => "yes\n",
            timeout  => $timeout,
            optional => 1,
        },
        +{ name => "rsync password", expect => qr/[Pp]assword:/, send => $opts->{password} . "\n", timeout => $timeout },
    ]
}

## ssh-keygen — passphrase entered twice. Empty `passphrase` ⇒ no passphrase.
## Optional `overwrite => 1|0` answers the "Overwrite (y/n)?" prompt.
fn Fleet::Recipes::ssh_keygen ($opts = undef) {
    $opts //= +{}
    val $pass    = $opts->{passphrase} // ""
    val $timeout = $opts->{timeout} // 15
    var @steps
    if (defined $opts->{overwrite}) {
        push @steps, +{
            name     => "overwrite",
            expect   => qr/Overwrite \(y\/n\)\? ?/,
            send     => ($opts->{overwrite} ? "y" : "n") . "\n",
            timeout  => $timeout,
            optional => 1,
        }
    }
    push @steps,
        +{ name => "passphrase",  expect => qr/Enter passphrase.*: ?/,         send => $pass . "\n", timeout => $timeout },
        +{ name => "passphrase2", expect => qr/Enter same passphrase again: ?/, send => $pass . "\n", timeout => $timeout }
    [@steps]
}

## git clone/fetch — ssh key passphrase and/or https username+password.
## Provide whichever the transport needs; all steps are optional.
fn Fleet::Recipes::git_clone ($opts = undef) {
    $opts //= +{}
    val $timeout = $opts->{timeout} // 60
    var @steps = (
        +{
            name     => "host key",
            expect   => qr/\(yes\/no(?:\/\[fingerprint\])?\)\?/,
            send     => "yes\n",
            timeout  => $timeout,
            optional => 1,
        },
    )
    if (defined $opts->{passphrase}) {
        push @steps, +{ name => "key passphrase", expect => qr/Enter passphrase for key.*: ?|[Pp]assphrase: ?/, send => $opts->{passphrase} . "\n", timeout => $timeout, optional => 1 }
    }
    if (defined $opts->{user}) {
        push @steps, +{ name => "https username", expect => qr/Username for .*: ?/, send => $opts->{user} . "\n", timeout => $timeout, optional => 1 }
    }
    if (defined $opts->{password}) {
        push @steps, +{ name => "https password", expect => qr/Password for .*: ?/, send => $opts->{password} . "\n", timeout => $timeout, optional => 1 }
    }
    [@steps]
}

## kinit — Kerberos ticket: single "Password for principal@REALM:" prompt.
fn Fleet::Recipes::kinit ($opts) {
    die "Fleet::Recipes::kinit: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "kerberos password", expect => qr/[Pp]assword for .*: ?/, send => $opts->{password} . "\n", timeout => $timeout },
    ]
}

## smbclient — SMB password then the "smb: \>" interactive prompt.
fn Fleet::Recipes::smbclient ($opts) {
    die "Fleet::Recipes::smbclient: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "smb password", expect => qr/[Pp]assword.*: ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "smb prompt",   expect => qr/smb: .*\\> ?$/m,   timeout => $timeout, optional => 1 },
    ]
}

## vault login (userpass/ldap) — hidden password prompt, then success banner.
fn Fleet::Recipes::vault_login ($opts) {
    die "Fleet::Recipes::vault_login: password required" unless defined $opts->{password}
    val $timeout = $opts->{timeout} // 30
    [
        +{ name => "vault password", expect => qr/Password \(will be hidden\): ?/, send => $opts->{password} . "\n", timeout => $timeout },
        +{ name => "vault success",  expect => qr/Success! You are now authenticated/i, timeout => $timeout, optional => 1 },
    ]
}

## `aws configure`: access key, secret key, region, output format. opts:
## access_key, secret_key (required), region (default ""), output (default "json").
fn Fleet::Recipes::aws_configure ($opts) {
    die "Fleet::Recipes::aws_configure: access_key required" unless defined $opts->{access_key}
    die "Fleet::Recipes::aws_configure: secret_key required" unless defined $opts->{secret_key}
    val $t = $opts->{timeout} // 15
    [
        +{ name => "access key", expect => qr/AWS Access Key ID/,     send => $opts->{access_key} . "\n",          timeout => $t },
        +{ name => "secret key", expect => qr/AWS Secret Access Key/, send => $opts->{secret_key} . "\n",          timeout => $t },
        +{ name => "region",     expect => qr/Default region name/,   send => ($opts->{region} // "") . "\n",      timeout => $t },
        +{ name => "output",     expect => qr/Default output format/, send => ($opts->{output} // "json") . "\n",  timeout => $t },
    ]
}

## `htpasswd -c file user`: New password / Re-type new password. opts: password.
fn Fleet::Recipes::htpasswd ($opts) {
    die "Fleet::Recipes::htpasswd: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 15
    [
        +{ name => "new password", expect => qr/New password:/,         send => $opts->{password} . "\n", timeout => $t },
        +{ name => "confirm",      expect => qr/Re-type new password:/, send => $opts->{password} . "\n", timeout => $t },
    ]
}

## Java `keytool`: keystore password, and a re-enter prompt when creating
## (pass confirm => 1). opts: password (required), confirm.
fn Fleet::Recipes::keytool ($opts) {
    die "Fleet::Recipes::keytool: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 15
    var @steps = (
        +{ name => "keystore password", expect => qr/Enter keystore password:/, send => $opts->{password} . "\n", timeout => $t },
    )
    if ($opts->{confirm}) {
        push @steps, +{ name => "re-enter password", expect => qr/Re-enter new password:/, send => $opts->{password} . "\n", timeout => $t }
    }
    [@steps]
}

## `ansible-vault`: existing "Vault password:" prompt, or the
## "New Vault password:" + "Confirm New Vault password:" pair when new => 1.
## opts: password (required), new.
fn Fleet::Recipes::ansible_vault ($opts) {
    die "Fleet::Recipes::ansible_vault: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 15
    if ($opts->{new}) {
        return [
            +{ name => "new vault password",     expect => qr/New Vault password:/,         send => $opts->{password} . "\n", timeout => $t },
            +{ name => "confirm vault password", expect => qr/Confirm New Vault password:/, send => $opts->{password} . "\n", timeout => $t },
        ]
    }
    [ +{ name => "vault password", expect => qr/Vault password:/, send => $opts->{password} . "\n", timeout => $t } ]
}

## Oracle `sqlplus`: "Enter user-name:" then "Enter password:". opts:
## user, password (both required).
fn Fleet::Recipes::sqlplus ($opts) {
    die "Fleet::Recipes::sqlplus: user required"     unless defined $opts->{user}
    die "Fleet::Recipes::sqlplus: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 30
    [
        +{ name => "username", expect => qr/Enter user-name:/, send => $opts->{user} . "\n",     timeout => $t },
        +{ name => "password", expect => qr/Enter password:/,  send => $opts->{password} . "\n", timeout => $t },
    ]
}

## 1Password CLI `op signin`: account master-password prompt. opts: password.
fn Fleet::Recipes::op_signin ($opts) {
    die "Fleet::Recipes::op_signin: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 30
    [
        +{ name => "master password", expect => qr/Enter the password for|[Pp]assword:/, send => $opts->{password} . "\n", timeout => $t },
    ]
}

## `ssh-add`: decrypt a private key by passphrase. opts: passphrase (required).
fn Fleet::Recipes::ssh_add ($opts) {
    die "Fleet::Recipes::ssh_add: passphrase required" unless defined $opts->{passphrase}
    val $t = $opts->{timeout} // 15
    [
        +{ name => "key passphrase", expect => qr/Enter passphrase for/, send => $opts->{passphrase} . "\n", timeout => $t },
    ]
}

## `unzip` of an encrypted archive: the per-archive "password:" prompt. opts:
## password (required).
fn Fleet::Recipes::unzip_encrypted ($opts) {
    die "Fleet::Recipes::unzip_encrypted: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 15
    [
        +{ name => "archive password", expect => qr/password:/i, send => $opts->{password} . "\n", timeout => $t },
    ]
}

## Cassandra `cqlsh`: optional password prompt, then the "cqlsh>" prompt.
## opts: password, timeout.
fn Fleet::Recipes::cqlsh ($opts = undef) {
    $opts //= +{}
    val $t = $opts->{timeout} // 15
    var @steps
    if (defined $opts->{password}) {
        push @steps, +{ name => "password", expect => qr/[Pp]assword:/, send => $opts->{password} . "\n", timeout => $t }
    }
    push @steps, +{ name => "cqlsh prompt", expect => qr/cqlsh[^>]*> ?$/m, timeout => $t }
    [@steps]
}

## `gcloud auth login --no-launch-browser`: paste the authorization code from
## the printed URL. opts: code (required).
fn Fleet::Recipes::gcloud_auth ($opts) {
    die "Fleet::Recipes::gcloud_auth: code required" unless defined $opts->{code}
    val $t = $opts->{timeout} // 120
    [
        +{ name => "authorization code", expect => qr/Enter authorization code:/, send => $opts->{code} . "\n", timeout => $t },
    ]
}

## `heroku login -i`: email then password. opts: email, password (both required).
fn Fleet::Recipes::heroku_login ($opts) {
    die "Fleet::Recipes::heroku_login: email required"    unless defined $opts->{email}
    die "Fleet::Recipes::heroku_login: password required" unless defined $opts->{password}
    val $t = $opts->{timeout} // 30
    [
        +{ name => "email",    expect => qr/Email:/,       send => $opts->{email} . "\n",    timeout => $t },
        +{ name => "password", expect => qr/[Pp]assword:/, send => $opts->{password} . "\n", timeout => $t },
    ]
}

## All recipe names this sublib ships.
fn Fleet::Recipes::names {
    qw(ssh_login sudo psql mysql redis_cli yes_to_all cisco_enable
       su telnet_login sftp passwd_change docker_login
       scp gpg_decrypt ftp_login openssl_pem mongo npm_login
       rsync ssh_keygen git_clone kinit smbclient vault_login
       aws_configure htpasswd keytool ansible_vault sqlplus op_signin
       ssh_add unzip_encrypted cqlsh gcloud_auth heroku_login)
}
